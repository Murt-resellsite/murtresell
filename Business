    if(!r.date){
      for(i = 0; i < lines.length && !r.date; i++){
        lines[i].segs.forEach(function(sg){ if(!r.date && !/\bdue\b/i.test(sg.text)) r.date = parseDate(sg.text); });
      }
    }

    // --- Invoice / order number ---
    var nm1 = /\b(?:invoice|inv|order|receipt|po|p\.o\.)\s*(?:no\.?|number|num|#|id)\s*[:#]?\s*#?\s*([A-Z0-9][A-Z0-9\-\/]{1,24})/i.exec(all);
    var nm2 = /\bINV[-\s]?(\d{2,}[A-Z0-9\-]*)\b/.exec(all);
    var nm3 = /\b(?:invoice|order)\s+#?\s*(\d[A-Z0-9\-]{1,24})\b/i.exec(all);
    if(nm1 && /\d/.test(nm1[1])) r.number = nm1[1].replace(/[\-\/]+$/, "");
    else if(nm2) r.number = "INV-" + nm2[1];
    else if(nm3) r.number = nm3[1];

    // --- Total ---
    r.total = findTotal(lines);

    // --- Bottle / item count ---
    r.count = findCount(lines, all);
    r.unit = FRAGRANCE_RE.test(all) ? "bottles" : "items";
    return r;
  }

  function guessDocType(lower, ctx){
    var tests = [
      ["Tax Form", /\bw-?9\b|\b1099\b|seller'?s\s+permit|resale\s+certificate|tax\s+exempt/],
      ["Invoice", /\binvoice\b/],
      ["Receipt", /\breceipt\b|\bpaid\s+with\b|\bthank\s+you\s+for\s+your\s+purchase\b/],
      ["Packing Slip", /packing\s*(slip|list)/],
      ["Purchase Order", /purchase\s+order/],
      ["Statement", /\bstatement\b/],
      ["Quote", /\b(quote|quotation|estimate)\b/],
      ["Order Confirmation", /order\s+confirm|order\s*(#|number|no\.)/],
      ["Shipping Label", /shipping\s+label|tracking\s*(#|number|no\.)|\busps\b|\bups\b|\bfedex\b|\bdhl\b/],
      ["Contract", /\bagreement\b|\bcontract\b/]
    ];
    for(var i = 0; i < tests.length; i++) if(tests[i][1].test(lower)) return tests[i][0];
    if(isImage(ctx.mime, ctx.name)) return /screen\s?shot/i.test(ctx.name) ? "Screenshot" : "Photo";
    if(/\.(xlsx?|csv|tsv|numbers|ods)$/i.test(ctx.name)) return "Spreadsheet";
    if(isPdf(ctx.mime, ctx.name)) return "PDF";
    return "Document";
  }

  function vendorFromFilename(name){
    var base = String(name || "").replace(/\.[a-z0-9]{1,5}$/i, "").replace(/[_\-.+]+/g, " ");
    base = base.replace(/\b(invoice|invoices|inv|receipt|scan(ned)?|img|image|photo|pic|screenshot|screen shot|document|doc|file|copy|final|pdf|page|order|statement|download(ed)?|whatsapp|at|pm|am)\b/ig, " ")
               .replace(/\b[a-f0-9]{8,}\b/ig, " ").replace(/\(\d+\)/g, " ").replace(/\b\d+\b/g, " ").replace(/#/g, " ")
               .replace(/\s+/g, " ").trim();
    return /[a-z]{3,}/i.test(base) ? cleanName(base.length < 4 ? base.toUpperCase() : base) : "";
  }

  function findVendor(lines, ctx, lower){
    // 1) An explicit label: "From:", "Vendor:", "Sold by:" ...
    for(var i = 0; i < lines.length; i++){
      var m = /^\s*(?:from|vendor|supplier|seller|sold\s+by|bill\s+from|remit\s+to|pay\s+to|merchant|company)\s*[:\-]\s*(.*)$/i.exec(lines[i].segs[0].text);
      if(m){
        var v = cleanName(m[1]) || (lines[i + 1] ? cleanName(lines[i + 1].segs[0].text) : "");
        if(v && /[a-z]{2,}/i.test(v) && !OWN_NAMES_RE.test(v) && !/@/.test(v)) return v;
      }
    }
    var fromFile = vendorFromFilename(ctx.name);
    // 2) A file name you gave it ("La Mina invoice.pdf") that also appears in the document —
    //    use the document's own spelling ("ULINE" → "Uline", not the file's "uline").
    var at = fromFile ? lower.indexOf(fromFile.toLowerCase()) : -1;
    if(at !== -1){
      var allText = lines.map(function(L){ return L.text; }).join("\n");
      return cleanName(allText.substr(at, fromFile.length)) || fromFile;
    }

    // 3) The biggest name-like text near the top of page 1 (logos/letterheads),
    //    skipping anything in the "Bill To / Ship To" block.
    if(!ctx.noLayout && lines.length){
      var blocked = [];
      lines.forEach(function(L, li){
        L.segs.forEach(function(s){
          if(/\b(bill(ed)?|ship(ped)?|sold|deliver|invoice)\s*to\b|\bcustomer\b|\bclient\b/i.test(s.text)) blocked.push({ li: li, x0: s.x0, page: L.page });
        });
      });
      var best = null;
      lines.forEach(function(L, li){
        if(L.page !== 1 || L.top > L.pageH * 0.38) return;
        L.segs.forEach(function(s){
          var t = cleanName(s.text);
          if(t.length < 3 || !/[a-z]{3,}/i.test(t)) return;
          if(GENERIC_SEG_RE.test(s.text.trim()) || OWN_NAMES_RE.test(t)) return;
          var digits = (t.match(/\d/g) || []).length;
          if(digits > t.length * 0.25 || /^\d/.test(t) || /@|www\.|\.com\b|https?:/i.test(s.text)) return;
          if(/\b[A-Z]{2}\s+\d{5}\b/.test(s.text) || /\b(street|st\.|ave|avenue|road|rd\.|blvd|suite|ste\.?|drive|dr\.|lane|ln\.)\b/i.test(s.text)) return;
          if(blocked.some(function(b){ return b.page === L.page && li > b.li && li <= b.li + 6 && Math.abs(s.x0 - b.x0) < 60; })) return;
          var score = L.h * (1.15 - L.top / (L.pageH || 1) * 0.4);
          if(!best || score > best.score) best = { t: t, score: score };
        });
      });
      if(best) return best.t;
    }
    // 4) A website or email domain, then the file name.
    var dm = /(?:www\.|@)([a-z0-9][a-z0-9\-]{2,})\.(?:com|net|co|shop|store|us|org|biz)\b/i.exec(lower);
    if(dm && !OWN_NAMES_RE.test(dm[1]) && !/^(gmail|yahoo|hotmail|outlook|icloud|aol|rocketmail)$/i.test(dm[1])) return titleCase(dm[1].replace(/-/g, " "));
    // The file name is a last resort for invoices only (for other files it just becomes the title).
    return ctx.kind === "invoice" ? fromFile : "";
  }

  function findTotal(lines){
    var labels = [
      /\bgrand\s*total\b/i, /\binvoice\s*total\b/i, /\border\s*total\b/i, /\btotal\s*amount\b/i, /\bamount\s*total\b/i,
      /\btotal\s*\(?usd\)?\b|\btotal\b/i, /\bamount\s*due\b/i, /\btotal\s*due\b/i, /\bbalance\s*due\b/i, /\bamount\s*paid\b/i
    ];
    var skip = /\bsub\s*-?\s*total\b|\btotal\s*(qty|quantity|items?|units?|pieces|pcs|bottles?|weight|discount|tax|savings)\b|\btax\s*total\b|\btotal\s*(paid\s*)?to\s*date\b/i;
    for(var p = 0; p < labels.length; p++){
      var found = null;
      for(var i = 0; i < lines.length; i++){
        var t = lines[i].text;
        if(!labels[p].test(t) || skip.test(t)) continue;
        // a table header row ("Description Qty Rate Total") isn't the totals line
        if(/\b(qty|quantity|description|rate|unit\s*price|price|item|sku)\b/i.test(t) && !moneyIn(t).length) continue;
        var after = t.slice(t.search(labels[p]));
        var nums = moneyIn(after);
        if(!nums.length && lines[i + 1]) nums = moneyIn(lines[i + 1].text);
        if(nums.length){
          var v = nums[nums.length - 1];
          if(v > 0) found = v;            // keep the LAST match (totals sit at the bottom)
        }
      }
      if(found !== null) return Math.round(found * 100) / 100;
    }
    var biggest = null;
    lines.forEach(function(L){
      if(!/\$/.test(L.text)) return;
      moneyIn(L.text).forEach(function(n){ if(n > 0 && (biggest === null || n > biggest)) biggest = n; });
    });
    return biggest;
  }

  function findCount(lines, all){
    // 1) The invoice says it outright: "Total Qty: 48", "Total Items 36", "Bottles: 24"
    var m = /\b(?:total\s*(?:qty|quantity|items?|units?|pieces|pcs|bottles?)|(?:qty|quantity|units?|pcs|bottles?)\s*total|item\s*count|no\.?\s*of\s*(?:items|bottles|units)|number\s*of\s*(?:items|bottles|units)|total\s*count)\b\s*[:#=]?\s*(\d{1,5})\b/i.exec(all);
    if(m) return parseInt(m[1], 10);

    // 2) Add up the "Qty" column of the item table.
    var HDR = /^(qty\.?|qtys?|quantity|qnty|units?|pcs|pieces|ordered|shipped)$/i;
    var OTHER_HDR = /^(description|item|items|product|products|name|price|rate|amount|total|unit|sku|style|details?|cost|each)$/i;
    var STOP = /\b(sub\s*-?\s*total|total|balance|amount\s+due|grand)\b/i;
    var sum = 0, rows = 0;
    for(var i = 0; i < lines.length; i++){
      var L = lines[i];
      var col = null, ci = -1;
      for(var w = 0; w < L.words.length; w++){
        if(HDR.test(L.words[w].t.replace(/[:]$/, ""))){ col = L.words[w]; ci = w; break; }
      }
      if(!col || !L.words.some(function(x){ return OTHER_HDR.test(x.t.replace(/[:]$/, "")); })) continue;
      // The Qty column reaches halfway to the headings on either side of it.
      var tol = Math.max(L.h * 1.5, (col.x1 - col.x0) * 0.8);
      var prevW = ci > 0 ? L.words[ci - 1] : null, nextW = ci < L.words.length - 1 ? L.words[ci + 1] : null;
      var left = Math.min(prevW ? (prevW.x1 + col.x0) / 2 : -Infinity, col.x0 - tol);
      var right = Math.max(nextW ? (col.x1 + nextW.x0) / 2 : Infinity, col.x1 + tol);
      var colMid = (col.x0 + col.x1) / 2;
      for(var j = i + 1; j < lines.length && lines[j].page === L.page; j++){
        var R = lines[j];
        if(STOP.test(R.text)) break;
        var pick = null;
        for(var k = 0; k < R.words.length; k++){
          var wd = R.words[k], mid = (wd.x0 + wd.x1) / 2;
          if(mid < left || mid > right) continue;
          var nm = /^(\d{1,4})(?:\.0+)?$/.exec(wd.t.replace(/,/g, ""));
          if(nm && (!pick || Math.abs(mid - colMid) < pick.d)) pick = { n: parseInt(nm[1], 10), d: Math.abs(mid - colMid) };
        }
        if(pick){ sum += pick.n; rows++; }
      }
    }
    if(rows) return sum;

    // 3) Receipt style lines: "2 x Hawas Ice" / "Hawas Ice x2"
    var xs = 0, xr = 0, re = /(?:^|\s)(\d{1,3})\s?[x×]\s+[a-z]|[a-z]\)?\s+[x×]\s?(\d{1,3})\b/gi, mm;
    lines.forEach(function(L){ re.lastIndex = 0; if((mm = re.exec(L.text))){ xs += parseInt(mm[1] || mm[2], 10); xr++; } });
    if(xr) return xs;
    return null;
  }

  // Read one file → simple details. Never throws; worst case returns the basics.
  function readFileDetails(blob, mime, name, kind, onStatus){
    var ctx = { kind: kind, mime: mime, name: name, noLayout: false };
    var job;
    if(isPdf(mime, name)){ if(onStatus) onStatus("Reading PDF..."); job = readPdf(blob, onStatus).then(function(r){ ctx.pages = r.pages; return r.lines; }); }
    else if(isImage(mime, name)){ if(onStatus) onStatus("Reading photo..."); job = ocrLines(blob, onStatus); }
    else if(isTextLike(mime, name)){ ctx.noLayout = true; job = readTextFile(blob, name); }
    else job = Promise.resolve([]);
    return job.then(function(lines){
      var r = analyzeLines(lines || [], ctx);
      r.read = (lines || []).length > 0;
      r.pages = ctx.pages || null;
      return r;
    }).catch(function(err){
      console.warn("Couldn't read " + name + ":", err);
      var r = analyzeLines([], ctx);
      r.read = false;
      return r;
    });
  }

  /* ---------- storing files in the cloud ---------- */
  function prepareFileForStorage(file){
    var mime = file.type || "";
    if(!isImage(mime, file.name) || /gif$/i.test(mime)) return Promise.resolve({ blob: file, mime: mime || "application/octet-stream", name: file.name });
    // Photos: keep them sharp enough to read, but not 8 MB.
    return new Promise(function(resolve){
      var url = URL.createObjectURL(file), img = new Image();
      img.onload = function(){
        var w = img.naturalWidth, h = img.naturalHeight, max = 2400;
        URL.revokeObjectURL(url);
        if(file.size <= 1.5 * 1024 * 1024 && w <= max && h <= max){ resolve({ blob: file, mime: mime, name: file.name }); return; }
        var s = Math.min(1, max / Math.max(w, h));
        var c = document.createElement("canvas");
        c.width = Math.round(w * s); c.height = Math.round(h * s);
        var g = c.getContext("2d");
        g.fillStyle = "#fff"; g.fillRect(0, 0, c.width, c.height);
        g.drawImage(img, 0, 0, c.width, c.height);
        c.toBlob(function(b){
          resolve(b ? { blob: b, mime: "image/jpeg", name: file.name.replace(/\.[a-z0-9]+$/i, "") + ".jpg" } : { blob: file, mime: mime, name: file.name });
        }, "image/jpeg", 0.85);
      };
      img.onerror = function(){ URL.revokeObjectURL(url); resolve({ blob: file, mime: mime, name: file.name }); };
      img.src = url;
    });
  }
  function blobToBase64(blob){
    return blob.arrayBuffer().then(function(buf){
      var bytes = new Uint8Array(buf), bin = "", step = 0x8000;
      for(var i = 0; i < bytes.length; i += step) bin += String.fromCharCode.apply(null, bytes.subarray(i, i + step));
      return btoa(bin);
    });
  }
  function base64ToBlob(b64, mime){
    var bin = atob(b64), bytes = new Uint8Array(bin.length);
    for(var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new Blob([bytes], { type: mime || "application/octet-stream" });
  }
  function fileDocRef(id){ return FILES.db.collection("murtresell").doc("dlfile-" + id); }
  function partDocRef(id, n){ return FILES.db.collection("murtresell").doc("dlfile-" + id + "-p" + n); }
  function uploadParts(id, b64, onPct){
    var n = Math.max(1, Math.ceil(b64.length / FILE_B64_CHUNK)), chain = Promise.resolve();
    for(var i = 0; i < n; i++){
      (function(i){
        chain = chain.then(function(){
          return partDocRef(id, i).set({ type: "dl-file-part", fileId: id, n: i, data: b64.slice(i * FILE_B64_CHUNK, (i + 1) * FILE_B64_CHUNK) })
            .then(function(){ if(onPct) onPct(Math.round((i + 1) / n * 100)); });
        });
      })(i);
    }
    return chain.then(function(){ return n; });
  }
  function deleteParts(id, n){
    var jobs = [];
    for(var i = 0; i < n; i++) jobs.push(partDocRef(id, i).delete().catch(function(){}));
    return Promise.all(jobs);
  }
  function getFileBlob(meta){
    if(FILES.urlCache[meta.id]) return Promise.resolve(FILES.urlCache[meta.id]);
    var jobs = [];
    for(var i = 0; i < (meta.parts || 1); i++) jobs.push(partDocRef(meta.id, i).get());
    return Promise.all(jobs).then(function(snaps){
      var b64 = snaps.map(function(s){ var d = s.exists ? s.data() : null; if(!d) throw new Error("missing part"); return d.data; }).join("");
      var url = URL.createObjectURL(base64ToBlob(b64, meta.mime));
      FILES.urlCache[meta.id] = url;
      return url;
    });
  }

  /* ---------- upload flow ---------- */
  var filesQueue = Promise.resolve();
  function filesPick(fileList, kind){
    if(!fileList || !fileList.length) return;
    if(!FILES.ready || !FILES.db){ toast("Files need the cloud connection — try again in a moment"); return; }
    Array.prototype.forEach.call(fileList, function(file){
      var p = { id: uid(), kind: kind, name: file.name, status: "Waiting...", pct: 0 };
      FILES.pending.push(p);
      filesQueue = filesQueue.then(function(){ return processUpload(p, file); });
    });
    renderFiles();
  }
  function processUpload(p, file){
    var prepared = null, partCount = 0;
    function status(msg){ p.status = msg; renderFilesSoon(); }
    status("Reading...");
    return prepareFileForStorage(file).then(function(prep){
      prepared = prep;
      if(prep.blob.size > FILE_MAX_BYTES) throw new Error("too-big");
      return withTimeout(readFileDetails(prep.blob, prep.mime, file.name, p.kind, status), 120000, { read: false });
    }).then(function(details){
      status("Uploading...");
      return blobToBase64(prepared.blob).then(function(b64){
        return uploadParts(p.id, b64, function(pct){ p.pct = pct; status("Uploading " + pct + "%..."); });
      }).then(function(n){
        partCount = n;
        var meta = {
          type: "dl-file", id: p.id, kind: p.kind, name: prepared.name || file.name, mime: prepared.mime || "",
          size: prepared.blob.size, parts: n, uploadedAt: new Date().toISOString(),
          docType: details.docType || (p.kind === "invoice" ? "Invoice" : "Document"),
          vendor: details.vendor || "", date: details.date || "", number: details.number || "",
          count: (details.count === null || details.count === undefined) ? null : details.count,
          unit: details.unit || "bottles", total: (details.total === null || details.total === undefined) ? null : details.total,
          pages: details.pages || null, readOk: !!details.read, note: "", loggedPurchaseId: ""
        };
        meta = JSON.parse(JSON.stringify(meta));   // Firestore rejects undefined values
        return fileDocRef(p.id).set(meta).then(function(){ return meta; });
      });
    }).then(function(meta){
      if(!FILES.list.some(function(f){ return f.id === meta.id; })) FILES.list.push(meta);
      removePending(p.id);
      renderFiles();
      toast(fileTitle(meta) + " saved");
    }).catch(function(err){
      if(!(err && err.message === "too-big")) console.error("Upload failed:", err);
      removePending(p.id);
      renderFiles();
      if(partCount) deleteParts(p.id, partCount);
      toast(err && err.message === "too-big" ? file.name + " is too big (20 MB max)" : "Couldn't upload " + file.name + " — check your connection");
    });
  }
  function removePending(id){ FILES.pending = FILES.pending.filter(function(x){ return x.id !== id; }); }

  /* ---------- live list from the cloud ---------- */
  function filesStart(){
    if(!window.firebase || !firebase.apps || !firebase.apps.length){ FILES.status = "Cloud isn't available — files need the cloud connection."; renderFiles(); return; }
    firebase.auth().onAuthStateChanged(function(user){ if(user) filesSubscribe(); });
  }
  function filesSubscribe(){
    if(FILES.unsub) return;
    FILES.db = firebase.firestore();
    FILES.unsub = FILES.db.collection("murtresell").where("type", "==", "dl-file").onSnapshot(function(snap){
      var list = [];
      snap.forEach(function(d){ var x = d.data(); if(x && x.id) list.push(x); });
      FILES.list = list;
      FILES.ready = true;
      renderFiles();
    }, function(err){
      console.error("Files listener error:", err);
      FILES.unsub = null;
      FILES.ready = false;
      FILES.status = "Couldn't load files (" + (err.code || "error") + ") — retrying...";
      renderFiles();
      setTimeout(filesSubscribe, 30000);
    });
  }

  /* ---------- rendering ---------- */
  function fileTitle(f){
    var v = f.vendor ? f.vendor : "";
    if(f.kind === "invoice") return (v || "Unknown Vendor") + " Invoice";
    var type = f.docType || "Document";
    // "California Resale Certificate", not "California Resale Certificate Tax Form"
    if(v && /\b(certificate|form|permit|label|slip|receipt|invoice|statement|agreement|contract|order|quote|estimate|w-?9|1099)$/i.test(v)) return v;
    if(v) return v + " " + type;
    if(/^(PDF|Document|Photo|Screenshot|Spreadsheet)$/.test(type)) return (f.name || type).replace(/\.[a-z0-9]{1,5}$/i, "");
    return type;
  }
  function fileWhen(f){ return f.date || (f.uploadedAt ? localDateStr(new Date(f.uploadedAt)) : ""); }
  function isLogged(f){ return !!(f.loggedPurchaseId && state.inventory.some(function(i){ return i.id === f.loggedPurchaseId; })); }
  function countLabel(n, unit){ return n + " " + (unit === "items" ? (n === 1 ? "item" : "items") : (n === 1 ? "bottle" : "bottles")); }
  // "3 invoices · 120 bottles · $4,560.00" (items listed separately if any invoice counts items)
  function invoiceStats(list){
    var bottles = 0, items = 0, money = 0;
    list.forEach(function(f){
      if(f.count) { if(f.unit === "items") items += f.count; else bottles += f.count; }
      if(f.total) money += f.total;
    });
    return list.length + " invoice" + (list.length === 1 ? "" : "s") + " · " + bottles + " bottles" +
           (items ? " · " + items + " items" : "") + " · " + fmtMoney(money);
  }
  function renderFilesSoon(){ clearTimeout(FILES.renderTimer); FILES.renderTimer = setTimeout(renderFiles, 80); }

  function renderFiles(){
    var listEl = document.getElementById("files-list");
    if(!listEl) return;
    var tab = FILES.tab, q = FILES.search.trim().toLowerCase();
    var counts = { invoice: 0, other: 0 };
    FILES.list.forEach(function(f){ counts[f.kind === "invoice" ? "invoice" : "other"]++; });
    document.getElementById("files-count-invoice").textContent = counts.invoice;
    document.getElementById("files-count-other").textContent = counts.other;
    document.querySelectorAll(".files-tab").forEach(function(b){ b.classList.toggle("active", b.dataset.filesTab === tab); });
    var isInv = tab === "invoice";
    document.getElementById("files-drop-title").textContent = isInv ? "Drop invoices here" : "Drop any other files here";
    document.getElementById("files-drop-sub").textContent = isInv ? "PDFs, photos or screenshots of invoices from your orders · pick several at once"
                                                                  : "Receipts, packing slips, shipping labels, contracts, spreadsheets — anything";
    document.getElementById("files-upload-label").textContent = isInv ? "+ Upload Invoice" : "+ Upload File";
    document.getElementById("files-input").setAttribute("accept", isInv ? ".pdf,image/*" : "");
    document.getElementById("files-search").placeholder = isInv ? "Search vendor, invoice #, file name..." : "Search name, type, vendor...";
    document.getElementById("files-drop").classList.toggle("disabled", !FILES.ready);

    var items = FILES.list.filter(function(f){ return (f.kind === "invoice") === isInv; });
    if(q) items = items.filter(function(f){
      return [fileTitle(f), f.vendor, f.name, f.number, f.docType, f.note].join(" ").toLowerCase().indexOf(q) !== -1;
    });
    items.sort(function(a, b){ return fileWhen(b).localeCompare(fileWhen(a)) || (b.uploadedAt || "").localeCompare(a.uploadedAt || ""); });

    // Top line: totals for this tab
    var all = FILES.list.filter(function(f){ return (f.kind === "invoice") === isInv; });
    var sumLine = document.getElementById("files-summary-line");
    if(isInv){
      sumLine.textContent = invoiceStats(all) + " total";
    } else {
      sumLine.textContent = all.length + " file" + (all.length === 1 ? "" : "s");
    }

    var html = "";
    FILES.pending.filter(function(p){ return (p.kind === "invoice") === isInv; }).forEach(function(p){
      html += '<div class="file-card pending"><div class="file-badge">' + escapeHtml(fileExt(p.name)) + '</div><div class="file-main">' +
        '<div class="file-title">' + escapeHtml(p.status) + '</div><div class="file-meta">' + escapeHtml(p.name) + '</div>' +
        '<div class="file-progress"><span style="width:' + (p.pct || 4) + '%"></span></div></div></div>';
    });

    var lastMonth = null;
    items.forEach(function(f){
      var mk = fileWhen(f).slice(0, 7);
      if(mk !== lastMonth){
        lastMonth = mk;
        var inMonth = items.filter(function(x){ return fileWhen(x).slice(0, 7) === mk; });
        var stats = isInv ? invoiceStats(inMonth) : inMonth.length + " file" + (inMonth.length === 1 ? "" : "s");
        html += '<div class="files-month"><span class="files-month-name">' + escapeHtml(mk ? fmtMonthLabel(mk) : "No date") + '</span><span class="files-month-stats">' + stats + '</span></div>';
      }
      html += fileCardHtml(f);
    });
    listEl.innerHTML = html;

    var empty = document.getElementById("files-empty");
    var showEmpty = !html;
    empty.style.display = showEmpty ? "block" : "none";
    if(showEmpty){
      empty.textContent = !FILES.ready ? FILES.status
        : q ? "Nothing matches your search."
        : isInv ? "No invoices uploaded yet." : "No other files uploaded yet.";
    }
  }

  function fileCardHtml(f){
    var facts = "";
    if(f.kind === "invoice"){
      facts += (f.count !== null && f.count !== undefined)
        ? '<span class="fact strong">' + countLabel(f.count, f.unit) + '</span>'
        : '<span class="fact missing" data-file-edit="' + f.id + '">+ ' + (f.unit === "items" ? "items" : "bottles") + '</span>';
      facts += (f.total !== null && f.total !== undefined)
        ? '<span class="fact money">' + fmtMoney(f.total) + '</span>'
        : '<span class="fact missing" data-file-edit="' + f.id + '">+ total</span>';
    } else {
      if(f.count) facts += '<span class="fact strong">' + countLabel(f.count, f.unit) + '</span>';
      if(f.total !== null && f.total !== undefined) facts += '<span class="fact money">' + fmtMoney(f.total) + '</span>';
    }
    if(f.date) facts += '<span class="fact">' + fmtDate(f.date) + '</span>';
    if(f.number) facts += '<span class="fact">#' + escapeHtml(f.number) + '</span>';
    if(f.kind === "invoice" && isLogged(f)) facts += '<span class="fact logged">✓ In purchases</span>';

    var meta = escapeHtml(f.name || "") + " · " + fmtSize(f.size) + (f.pages ? " · " + f.pages + " page" + (f.pages === 1 ? "" : "s") : "") +
               " · uploaded " + fmtDate(f.uploadedAt ? localDateStr(new Date(f.uploadedAt)) : "");
    if(!f.readOk && (isPdf(f.mime, f.name) || isImage(f.mime, f.name))) meta += " · couldn't read text — tap Edit";

    var actions = '<button class="btn btn-ghost btn-small" data-file-view="' + f.id + '">View</button>' +
                  '<button class="btn btn-ghost btn-small" data-file-edit="' + f.id + '">Edit</button>';
    if(f.kind === "invoice" && !isLogged(f)) actions += '<button class="btn btn-ghost btn-small" data-file-log="' + f.id + '" title="Add this invoice to your Inventory Purchases log">Log Purchase</button>';
    if(f.kind !== "invoice" && f.docType === "Invoice") actions += '<button class="btn btn-ghost btn-small" data-file-move="' + f.id + '">Move to Invoices</button>';
    actions += '<button class="btn btn-danger btn-small" data-file-del="' + f.id + '" title="Delete">✕</button>';

    return '<div class="file-card" data-file-id="' + f.id + '">' +
      '<div class="file-badge' + (f.kind === "invoice" ? " inv" : "") + '">' + escapeHtml(fileExt(f.name)) + '</div>' +
      '<div class="file-main"><div class="file-title">' + escapeHtml(fileTitle(f)) + '</div>' +
      (facts ? '<div class="file-facts">' + facts + '</div>' : '') +
      '<div class="file-meta">' + meta + '</div>' +
      (f.note ? '<div class="file-note">' + escapeHtml(f.note) + '</div>' : '') +
      '</div><div class="file-actions">' + actions + '</div></div>';
  }

  function findFile(id){ return FILES.list.find(function(f){ return f.id === id; }); }
  function saveFileMeta(f, changes){
    Object.keys(changes).forEach(function(k){ f[k] = changes[k]; });
    renderFiles();
    return fileDocRef(f.id).set(JSON.parse(JSON.stringify(changes)), { merge: true }).catch(function(err){
      console.error("Save failed:", err);
      toast("Couldn't save — check your connection");
    });
  }

  /* ---------- actions ---------- */
  function openModal(id){ document.getElementById(id).classList.add("open"); }
  function closeModals(){
    document.querySelectorAll(".dl-modal.open").forEach(function(m){ m.classList.remove("open"); });
    document.getElementById("file-view-body").innerHTML = "";
    FILES.editingId = null;
  }

  function viewFile(f){
    document.getElementById("file-view-title").textContent = fileTitle(f);
    document.getElementById("file-view-sub").textContent = (f.name || "") + " · " + fmtSize(f.size);
    var body = document.getElementById("file-view-body");
    body.innerHTML = '<div class="file-view-msg">Loading...</div>';
    var openA = document.getElementById("file-view-open"), dlA = document.getElementById("file-view-download");
    openA.removeAttribute("href"); dlA.removeAttribute("href");
    openModal("file-view-modal");
    getFileBlob(f).then(function(url){
      if(!document.getElementById("file-view-modal").classList.contains("open")) return;
      openA.href = url; dlA.href = url; dlA.setAttribute("download", f.name || "file");
      if(isImage(f.mime, f.name)) body.innerHTML = '<img alt="" src="' + url + '">';
      else if(isPdf(f.mime, f.name)) body.innerHTML = '<iframe title="File preview" src="' + url + '"></iframe>';
      else body.innerHTML = '<div class="file-view-msg">No preview for this type — use Download.</div>';
    }).catch(function(err){
      console.error(err);
      body.innerHTML = '<div class="file-view-msg">Couldn\'t load this file — check your connection.</div>';
    });
  }

  function editFile(f){
    FILES.editingId = f.id;
    document.getElementById("file-edit-name").textContent = f.name || "";
    document.getElementById("fe-kind").value = f.kind === "invoice" ? "invoice" : "other";
    document.getElementById("fe-vendor").value = f.vendor || "";
    document.getElementById("fe-type").value = f.docType || "";
    document.getElementById("fe-date").value = f.date || "";
    document.getElementById("fe-count").value = (f.count === null || f.count === undefined) ? "" : f.count;
    document.getElementById("fe-total").value = (f.total === null || f.total === undefined) ? "" : f.total;
    document.getElementById("fe-number").value = f.number || "";
    document.getElementById("fe-unit").value = f.unit === "items" ? "items" : "bottles";
    document.getElementById("fe-note").value = f.note || "";
    syncEditForm();
    openModal("file-edit-modal");
    setTimeout(function(){ document.getElementById("fe-vendor").focus(); }, 50);
  }
  function syncEditForm(){
    var inv = document.getElementById("fe-kind").value === "invoice";
    document.getElementById("fe-type-wrap").style.display = inv ? "none" : "";
    document.getElementById("fe-count-label").textContent = document.getElementById("fe-unit").value === "items" ? "Items" : "Bottles";
  }
  function saveEdit(){
    var f = findFile(FILES.editingId);
    if(!f){ closeModals(); return; }
    var kind = document.getElementById("fe-kind").value;
    var countV = document.getElementById("fe-count").value.trim(), totalV = document.getElementById("fe-total").value.trim();
    var changes = {
      kind: kind,
      vendor: cleanName(document.getElementById("fe-vendor").value) || document.getElementById("fe-vendor").value.trim(),
      docType: kind === "invoice" ? "Invoice" : (document.getElementById("fe-type").value.trim() || (f.docType === "Invoice" ? "Document" : f.docType) || "Document"),
      date: document.getElementById("fe-date").value || "",
      count: countV === "" ? null : Math.max(0, parseInt(countV, 10) || 0),
      total: totalV === "" ? null : Math.max(0, Math.round(parseFloat(totalV) * 100) / 100 || 0),
      number: document.getElementById("fe-number").value.trim().replace(/^#/, ""),
      unit: document.getElementById("fe-unit").value,
      note: document.getElementById("fe-note").value.trim()
    };
    closeModals();
    saveFileMeta(f, changes).then(function(){ toast("Details saved"); });
    if(kind !== FILES.tab){ FILES.tab = kind; try{ localStorage.setItem(FILE_TAB_KEY, kind); }catch(e){} renderFiles(); }
  }

  function logPurchase(f){
    if(f.total === null || f.total === undefined){ toast("Add the invoice total first (Edit)"); editFile(f); return; }
    var date = f.date || localDateStr();
    var entry = {
      id: uid(), date: date,
      item: (f.vendor || "Supplier") + " invoice" + (f.number ? " #" + f.number : ""),
      qty: f.count || 0, cost: f.total, vendor: f.vendor || "",
      notes: "From uploaded invoice: " + (f.name || "")
    };
    state.inventory.push(entry);
    saveInventory();
    ensureMonthExists(getMonthKey(date));
    saveFileMeta(f, { loggedPurchaseId: entry.id });
    refreshAllViews();
    toast("Added to purchases — " + fmtDate(date));
  }

  function deleteFile(f){
    if(!confirm('Delete "' + fileTitle(f) + '" (' + (f.name || "") + ')? This removes the file for good.')) return;
    FILES.list = FILES.list.filter(function(x){ return x.id !== f.id; });
    renderFiles();
    fileDocRef(f.id).delete().then(function(){
      return deleteParts(f.id, f.parts || 1);
    }).then(function(){ toast("File deleted"); }).catch(function(err){
      console.error("Delete failed:", err);
      toast("Couldn't delete — check your connection");
    });
    if(FILES.urlCache[f.id]){ URL.revokeObjectURL(FILES.urlCache[f.id]); delete FILES.urlCache[f.id]; }
  }

  function filesBindUi(){
    try{ var saved = localStorage.getItem(FILE_TAB_KEY); if(saved === "invoice" || saved === "other") FILES.tab = saved; }catch(e){}
    document.querySelectorAll(".files-tab").forEach(function(b){
      b.addEventListener("click", function(){
        FILES.tab = b.dataset.filesTab;
        try{ localStorage.setItem(FILE_TAB_KEY, FILES.tab); }catch(e){}
        renderFiles();
      });
    });
    var input = document.getElementById("files-input");
    input.addEventListener("change", function(){ filesPick(input.files, FILES.tab); input.value = ""; });
    document.getElementById("files-search").addEventListener("input", function(e){ FILES.search = e.target.value; renderFiles(); });
    var drop = document.getElementById("files-drop");
    ["dragenter", "dragover"].forEach(function(ev){ drop.addEventListener(ev, function(e){ e.preventDefault(); drop.classList.add("dragging"); }); });
    ["dragleave", "drop"].forEach(function(ev){ drop.addEventListener(ev, function(e){ e.preventDefault(); drop.classList.remove("dragging"); }); });
    drop.addEventListener("drop", function(e){ if(e.dataTransfer && e.dataTransfer.files) filesPick(e.dataTransfer.files, FILES.tab); });

    document.getElementById("files-list").addEventListener("click", function(e){
      var el = e.target.closest("[data-file-view],[data-file-edit],[data-file-log],[data-file-del],[data-file-move]");
      if(!el) return;
      var f = findFile(el.dataset.fileView || el.dataset.fileEdit || el.dataset.fileLog || el.dataset.fileDel || el.dataset.fileMove);
      if(!f) return;
      if(el.dataset.fileView) viewFile(f);
      else if(el.dataset.fileEdit) editFile(f);
      else if(el.dataset.fileLog) logPurchase(f);
      else if(el.dataset.fileDel) deleteFile(f);
      else if(el.dataset.fileMove){ saveFileMeta(f, { kind: "invoice", docType: "Invoice" }); toast("Moved to Invoices"); }
    });
    document.querySelectorAll("[data-close-modal]").forEach(function(b){ b.addEventListener("click", closeModals); });
    document.querySelectorAll(".dl-modal").forEach(function(m){ m.addEventListener("click", function(e){ if(e.target === m) closeModals(); }); });
    document.addEventListener("keydown", function(e){ if(e.key === "Escape") closeModals(); });
    document.getElementById("fe-kind").addEventListener("change", syncEditForm);
    document.getElementById("fe-unit").addEventListener("change", syncEditForm);
    document.getElementById("fe-save").addEventListener("click", saveEdit);
    renderFiles();
    if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", filesStart);
    else setTimeout(filesStart, 0);
  }
  filesBindUi();

  /* ---------------- Init ---------------- */
  function init(){
    loadState();
    computeMonthsUnion();
    ensureMonthExists(todayMonthKey());
    if(state.currentMonth !== "all" && state.currentMonth.indexOf("year:") !== 0 && state.months.indexOf(state.currentMonth) === -1){
      state.currentMonth = todayMonthKey();
      saveCurrentMonth();
    }
    populateCategorySelects();
    populateShowSelect();
    populateEmployeeDatalist();
    document.getElementById("exp-date").value = defaultDateForCurrentMonth();
    document.getElementById("show-date").value = defaultDateForCurrentMonth();
    document.getElementById("inv-date").value = defaultDateForCurrentMonth();
    document.getElementById("extra-work-date").value = defaultDateForCurrentMonth();
    document.getElementById("extra-work-rate").value = state.workerRate ? state.workerRate.toFixed(2) : "";
    document.getElementById("show-worker-rate").value = state.workerRate ? state.workerRate.toFixed(2) : "";
    document.getElementById("pplus-rate").value = state.commissionRate === undefined ? "5" : state.commissionRate;
    renderMonthBar();
    updatePeriodControls();
    updateContextLabels();
    renderExpenses();
    renderShows();
    renderEmployees();
    renderInventory();
    renderDashboard();
  }
  init();
  // Exposed so the cloud-sync script (loaded separately below) can pull in
  // updated data and re-render everything in place, without reloading the
  // whole page. Reloading the page on every remote update was the cause of
  // the "keeps refreshing" bug on a second device.
  window.dropLedgerReloadFromCloud = init;
})();
</script>


<script>
(function(){
  "use strict";
  if(!window.firebase){
    var errEl0 = document.getElementById("cloudLoginError");
    if(errEl0) errEl0.textContent = "Firebase failed to load. Check internet/ad blocker.";
    return;
  }
  var firebaseConfig = {
    apiKey: "AIzaSyDzsyn1pY_Z_eEgVnXDIild2emvAJHtMPY",
    authDomain: "murtresell313.firebaseapp.com",
    projectId: "murtresell313",
    storageBucket: "murtresell313.firebasestorage.app",
    messagingSenderId: "255971319342",
    appId: "1:255971319342:web:35652dcfdbbeca6fc149bf"
  };

  var CLOUD_KEYS = [
    "dropledger_expenses_v1",
    "dropledger_shows_v1",
    "dropledger_categories_v1",
    "dropledger_inventory_v1",
    "dropledger_months_v1",
    "dropledger_current_month_v1",
    "dropledger_worker_rate_v1",
    "dropledger_commission_rate_v1",
    "dropledger_employees_v1",
    "dropledger_employee_work_v1"
  ];

  var UNLOCK_KEY = "murtresell_unlocked_v1";
  var PASSWORD_HASH = "b2f8f029ee094535e11dab8baced6cc87d185c70c81d10fdf6692cc30c715734";
  var CLIENT_KEY = "dropledger_cloud_client_id_v1";
  var clientId = localStorage.getItem(CLIENT_KEY);
  if(!clientId){
    clientId = Date.now().toString(36) + Math.random().toString(36).slice(2);
    localStorage.setItem(CLIENT_KEY, clientId);
  }

  if(!firebase.apps.length) firebase.initializeApp(firebaseConfig);
  var db = firebase.firestore();
  var applyingCloud = false;
  var uploadTimer = null;
  var userDocRef = null;
  var unsubscribe = null;

  var overlay = document.getElementById("cloudLoginOverlay");
  var pill = document.getElementById("cloudSyncPill");
  var errEl = document.getElementById("cloudLoginError");
  var passEl = document.getElementById("cloudPassword");
  var signBtn = document.getElementById("cloudSignInBtn");

  function setStatus(msg){ if(pill){ pill.style.display = "block"; pill.innerHTML = msg; } }
  function setError(msg){ if(errEl) errEl.textContent = msg || ""; }
  function hideOverlay(){ if(overlay) overlay.style.display = "none"; }
  function showOverlay(){ if(overlay) overlay.style.display = "flex"; }
  async function sha256Hex(value){
    var data = new TextEncoder().encode(value);
    var digest = await crypto.subtle.digest('SHA-256', data);
    return Array.from(new Uint8Array(digest)).map(function(b){ return b.toString(16).padStart(2,'0'); }).join('');
  }

  function collectLocalData(){
    var out = {};
    CLOUD_KEYS.forEach(function(k){ out[k] = localStorage.getItem(k); });
    return out;
  }
  function applyCloudData(data){
    applyingCloud = true;
    CLOUD_KEYS.forEach(function(k){
      if(data && Object.prototype.hasOwnProperty.call(data, k) && data[k] !== undefined && data[k] !== null){
        localStorage.setItem(k, data[k]);
      }
    });
    applyingCloud = false;
  }
  var pendingLocalWrite = false;
  function uploadNow(){
    if(!userDocRef || applyingCloud) return Promise.resolve();
    var payload = collectLocalData();
    payload.updatedAt = firebase.firestore.FieldValue.serverTimestamp();
    payload.updatedBy = clientId;
    return userDocRef.set(payload, { merge: true }).then(function(){
      pendingLocalWrite = false;
      setStatus('Cloud: synced <button id="cloudLogoutBtn">Logout</button>');
      bindLogout();
    }).catch(function(e){
      pendingLocalWrite = false;
      console.error('Upload failed:', e);
      goOfflineMode('Cloud: save failed (' + (e.code || 'error') + ') — working locally, retrying...');
    });
  }
  function scheduleUpload(){
    if(applyingCloud || !userDocRef) return;
    pendingLocalWrite = true;
    clearTimeout(uploadTimer);
    setStatus('Cloud: saving...');
    uploadTimer = setTimeout(uploadNow, 650);
  }
  var rawSetItem = localStorage.setItem.bind(localStorage);
  localStorage.setItem = function(key, value){
    rawSetItem(key, value);
    if(CLOUD_KEYS.indexOf(key) !== -1) scheduleUpload();
  };
  function bindLogout(){
    var btn = document.getElementById('cloudLogoutBtn');
    if(btn){ btn.onclick = function(){ localStorage.removeItem(UNLOCK_KEY); location.reload(); }; }
  }
  async function doUnlock(){
    setError('');
    if(signBtn) signBtn.disabled = true;
    var pass = (passEl && passEl.value || '');
    if(!pass){ setError('Enter password.'); if(signBtn) signBtn.disabled=false; return; }
    try{
      var hash = await sha256Hex(pass);
      if(hash !== PASSWORD_HASH){ setError('Wrong password.'); return; }
      localStorage.setItem(UNLOCK_KEY, '1');
      hideOverlay();
      startCloudSync();
    }catch(e){ setError('Could not unlock.'); console.error(e); }
    finally{ if(signBtn) signBtn.disabled=false; }
  }
  if(signBtn){ signBtn.onclick = doUnlock; }
  if(passEl){ passEl.addEventListener('keydown', function(e){ if(e.key === 'Enter') doUnlock(); }); }

  function startCloudSync(){
    hideOverlay();
    setStatus('Cloud: connecting...');
    // Firestore rules require a real signed-in request (request.auth != null).
    // Anonymous auth gives every app instance that stable identity without
    // needing real accounts/emails — it's what actually lets the rules be
    // "must be signed in" instead of "wide open to anyone on the internet."
    firebase.auth().signInAnonymously().then(function(){
      connectCloudDoc();
    }).catch(function(e){
      console.error('Anonymous sign-in failed:', e);
      goOfflineMode('Cloud: offline (sign-in failed) — working locally');
    });
  }

  function connectCloudDoc(){
    setStatus('Cloud: loading...');
    userDocRef = db.collection('murtresell').doc('dropledger-main');
    userDocRef.get().then(function(doc){
      var cloud = doc.exists ? doc.data() : null;
      if(cloud){
        applyCloudData(cloud);
        if(window.dropLedgerReloadFromCloud) window.dropLedgerReloadFromCloud();
      }
      if(!cloud || !cloud.updatedAt){ uploadNow(); }
      else { setStatus('Cloud: synced <button id="cloudLogoutBtn">Logout</button>'); bindLogout(); }
      unsubscribe = userDocRef.onSnapshot(function(snap){
        if(!snap.exists) return;
        var data = snap.data();
        if(!data || data.updatedBy === clientId) return;
        if(pendingLocalWrite){
          // You just made a change here that hasn't finished uploading yet.
          // Applying this incoming snapshot now would overwrite that change
          // with older data — silently erasing whatever you just added. Skip
          // it; your own upload will go out momentarily, and if the other
          // device's change still matters after that, it'll arrive again in
          // a later snapshot once things settle.
          return;
        }
        applyCloudData(data);
        setStatus('Cloud: synced <button id="cloudLogoutBtn">Logout</button>');
        bindLogout();
        if(window.dropLedgerReloadFromCloud) window.dropLedgerReloadFromCloud();
      }, function(err){
        console.error('Sync listener error:', err);
        goOfflineMode('Cloud: connection lost — working locally, retrying...');
      });
    }).catch(function(e){
      console.error('Cloud connect failed:', e);
      goOfflineMode('Cloud: unavailable (' + (e.code || 'error') + ') — working locally, retrying...');
    });
  }

  // Never lock the person out of their own data over a cloud hiccup. The
  // password screen already controls who gets into the app; once they're in,
  // a Firestore problem should degrade to "keep working locally and retry
  // quietly in the background," not "show the login screen again."
  var offlineRetryTimer = null;
  function goOfflineMode(message){
    hideOverlay();
    setStatus(message);
    if(window.dropLedgerReloadFromCloud) window.dropLedgerReloadFromCloud();
    clearTimeout(offlineRetryTimer);
    offlineRetryTimer = setTimeout(function(){ startCloudSync(); }, 30000);
  }

  if(localStorage.getItem(UNLOCK_KEY) === '1'){
    startCloudSync();
  } else {
    showOverlay();
    setTimeout(function(){ if(passEl) passEl.focus(); }, 100);
  }
})();
</script>

