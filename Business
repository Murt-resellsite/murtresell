<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DROP LEDGER — Business Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#121212;
    --paper:#F5F3EF;
    --paper-dim:#EAE6DE;
    --hype:#FF4D2E;
    --gain:#1F9E8C;
    --line:#D8D3C6;
    --muted:#8A857A;
    --card:#FFFFFF;
    --shadow: 0 1px 0 rgba(18,18,18,0.06);
    --radius: 2px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Space Grotesk', sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  .mono{font-family:'IBM Plex Mono', monospace;}
  ::selection{background:var(--hype);color:var(--paper);}

  /* ---------- Header ---------- */
  header{
    background:var(--ink);
    color:var(--paper);
    padding:22px 28px 18px;
    position:sticky;
    top:0;
    z-index:50;
    border-bottom:3px solid var(--hype);
  }
  .header-row{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    max-width:1180px;
    margin:0 auto;
    flex-wrap:wrap;
    gap:10px;
  }
  .brand{
    font-family:'Anton', sans-serif;
    font-size:26px;
    letter-spacing:0.5px;
    text-transform:uppercase;
    display:flex;
    align-items:baseline;
    gap:10px;
  }
  .brand .dot{color:var(--hype);}
  .tagline{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:#B9B4A6;
    letter-spacing:0.06em;
    text-transform:uppercase;
  }
  nav{
    display:flex;
    gap:4px;
    max-width:1180px;
    margin:16px auto 0;
    flex-wrap:wrap;
  }
  nav button{
    background:transparent;
    border:1px solid #3A3A3A;
    color:#C9C5B8;
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    letter-spacing:0.05em;
    text-transform:uppercase;
    padding:9px 16px;
    cursor:pointer;
    transition:all .15s ease;
  }
  nav button:hover{border-color:var(--hype);color:var(--paper);}
  nav button.active{
    background:var(--hype);
    border-color:var(--hype);
    color:var(--ink);
    font-weight:600;
  }

  /* ---------- Month bar ---------- */
  .month-bar-outer{
    background:var(--paper-dim);
    border-bottom:1px solid var(--line);
  }
  .month-bar-inner{
    max-width:1180px;
    margin:0 auto;
    padding:12px 28px;
    display:flex;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
  }
  .month-bar-label{
    font-family:'IBM Plex Mono', monospace;
    font-size:10.5px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--muted);
    white-space:nowrap;
  }
  .month-pills{
    display:flex;
    gap:6px;
    flex-wrap:wrap;
    flex:1;
  }
  .month-pill{
    position:relative;
    background:var(--card);
    border:1px solid var(--line);
    color:var(--ink);
    font-family:'IBM Plex Mono', monospace;
    font-size:11.5px;
    padding:7px 12px;
    cursor:pointer;
    letter-spacing:0.02em;
  }
  .month-pill:hover{border-color:var(--hype);}
  .month-pill.active{
    background:var(--ink);
    border-color:var(--ink);
    color:var(--paper);
    font-weight:600;
  }
  .month-pill.all-time{font-style:italic;}
  .month-pill .del-x{
    margin-left:8px;
    color:var(--hype);
    font-weight:700;
  }
  .period-picker{
    display:flex;
    gap:6px;
    align-items:center;
    flex-wrap:wrap;
    width:100%;
    padding-bottom:8px;
    border-bottom:1px solid var(--line);
  }
  .period-picker select, .period-picker input[type="month"]{
    width:auto;
    min-width:135px;
    padding:6px 8px;
    font-size:12px;
  }
  .period-picker .period-now{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:var(--muted);
    margin-left:auto;
    text-transform:uppercase;
    letter-spacing:0.05em;
  }
  .month-add{
    display:flex;
    gap:6px;
    align-items:center;
  }
  .month-add input[type="month"]{
    width:150px;
    padding:6px 8px;
    font-size:12px;
  }

  main{
    max-width:1180px;
    margin:0 auto;
    padding:28px 28px 80px;
  }
  .view{display:none;}
  .view.active{display:block;}

  h2.section-title{
    font-family:'Anton', sans-serif;
    text-transform:uppercase;
    font-size:20px;
    letter-spacing:0.3px;
    margin:0 0 4px;
  }
  .section-sub{
    font-family:'IBM Plex Mono', monospace;
    font-size:11.5px;
    color:var(--muted);
    text-transform:uppercase;
    letter-spacing:0.05em;
    margin:0 0 18px;
  }

  /* ---------- Dashboard cards ---------- */
  .stat-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
    margin-bottom:26px;
  }
  @media(max-width:860px){.stat-grid{grid-template-columns:repeat(2,1fr);}}
  .stat-card{
    background:var(--card);
    border:1px solid var(--line);
    padding:16px 16px 14px;
    box-shadow:var(--shadow);
  }
  .stat-label{
    font-family:'IBM Plex Mono', monospace;
    font-size:10.5px;
    text-transform:uppercase;
    letter-spacing:0.07em;
    color:var(--muted);
    margin-bottom:8px;
  }
  .stat-value{
    font-family:'IBM Plex Mono', monospace;
    font-size:26px;
    font-weight:700;
  }
  .stat-value.gain{color:var(--gain);}
  .stat-value.loss{color:var(--hype);}

  /* ---------- Receipt ---------- */
  .receipt{
    background:var(--card);
    border:1px solid var(--line);
    max-width:420px;
    padding:22px 24px 20px;
    box-shadow:var(--shadow);
    font-family:'IBM Plex Mono', monospace;
  }
  .receipt-title{
    font-family:'Anton', sans-serif;
    font-size:15px;
    text-transform:uppercase;
    text-align:center;
    letter-spacing:0.08em;
    margin-bottom:2px;
  }
  .receipt-sub{
    text-align:center;
    font-size:10px;
    color:var(--muted);
    text-transform:uppercase;
    letter-spacing:0.08em;
    margin-bottom:14px;
  }
  .receipt-divider{
    border:none;
    border-top:1px dashed var(--line);
    margin:10px 0;
  }
  .receipt-row{
    display:flex;
    justify-content:space-between;
    font-size:12.5px;
    padding:4px 0;
  }
  .receipt-row.total{
    font-weight:700;
    font-size:14px;
    border-top:1px solid var(--ink);
    margin-top:8px;
    padding-top:10px;
  }
  .receipt-row .r-amt.neg{color:var(--hype);}
  .receipt-row .r-amt.pos{color:var(--gain);}
  .receipt-foot{
    text-align:center;
    font-size:10px;
    color:var(--muted);
    margin-top:16px;
    letter-spacing:0.06em;
  }

  /* ---------- Category bars ---------- */
  .bars-wrap{
    background:var(--card);
    border:1px solid var(--line);
    padding:20px 22px;
    box-shadow:var(--shadow);
  }
  .bar-row{margin-bottom:12px;}
  .bar-row:last-child{margin-bottom:0;}
  .bar-label{
    display:flex;
    justify-content:space-between;
    font-size:12px;
    margin-bottom:5px;
    font-family:'IBM Plex Mono', monospace;
  }
  .bar-label .amt{color:var(--muted);}
  .bar-track{
    height:9px;
    background:var(--paper-dim);
    position:relative;
    overflow:hidden;
  }
  .bar-fill{
    height:100%;
    background:var(--hype);
  }

  .two-col{
    display:grid;
    grid-template-columns:420px 1fr;
    gap:20px;
    align-items:start;
  }
  @media(max-width:860px){.two-col{grid-template-columns:1fr;}}

  /* ---------- Forms ---------- */
  .form-card{
    background:var(--card);
    border:1px solid var(--line);
    padding:20px 22px;
    box-shadow:var(--shadow);
    margin-bottom:22px;
  }
  .form-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:12px;
    margin-bottom:12px;
  }
  label{
    display:block;
    font-family:'IBM Plex Mono', monospace;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--muted);
    margin-bottom:5px;
  }
  input, select, textarea{
    width:100%;
    border:1px solid var(--line);
    background:var(--paper);
    padding:9px 10px;
    font-family:'Space Grotesk', sans-serif;
    font-size:13.5px;
    color:var(--ink);
  }
  input:focus, select:focus, textarea:focus{
    outline:2px solid var(--hype);
    outline-offset:-1px;
    background:#fff;
  }
  .btn{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    font-weight:600;
    padding:10px 20px;
    border:none;
    cursor:pointer;
    transition:opacity .15s ease;
  }
  .btn:hover{opacity:0.85;}
  .btn-primary{background:var(--ink);color:var(--paper);}
  .btn-ghost{background:transparent;color:var(--ink);border:1px solid var(--line);}
  .btn-danger{background:transparent;color:var(--hype);border:1px solid var(--hype);}
  .btn-small{padding:5px 10px;font-size:10.5px;}

  /* ---------- Tables ---------- */
  table{width:100%;border-collapse:collapse;background:var(--card);}
  thead th{
    text-align:left;
    font-family:'IBM Plex Mono', monospace;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--muted);
    border-bottom:1px solid var(--ink);
    padding:9px 10px;
  }
  tbody td{
    padding:10px;
    font-size:13px;
    border-bottom:1px solid var(--paper-dim);
  }
  tbody tr:hover{background:var(--paper-dim);}
  .cat-tag{
    display:inline-block;
    font-family:'IBM Plex Mono', monospace;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:0.04em;
    padding:3px 8px;
    background:var(--paper-dim);
    border:1px solid var(--line);
  }
  .amt-neg{color:var(--hype);font-family:'IBM Plex Mono', monospace;font-weight:600;}
  .amt-pos{color:var(--gain);font-family:'IBM Plex Mono', monospace;font-weight:600;}
  .table-wrap{
    border:1px solid var(--line);
    overflow-x:auto;
    box-shadow:var(--shadow);
  }
  .empty-state{
    text-align:center;
    padding:40px 20px;
    color:var(--muted);
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:0.05em;
  }

  .toolbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:14px;
    flex-wrap:wrap;
    gap:10px;
  }
  .toolbar-actions{display:flex;gap:8px;flex-wrap:wrap;}

  .profit-preview{
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:var(--paper-dim);
    border:1px dashed var(--line);
    padding:12px 16px;
    margin-bottom:14px;
  }
  .pp-label{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--muted);
  }
  .pp-value{
    font-family:'IBM Plex Mono', monospace;
    font-size:20px;
    font-weight:700;
  }
  .pp-value.gain{color:var(--gain);}
  .pp-value.loss{color:var(--hype);}

  .show-card{
    background:var(--card);
    border:1px solid var(--line);
    box-shadow:var(--shadow);
    padding:16px 18px;
    margin-bottom:12px;
  }
  .show-card-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    flex-wrap:wrap;
    gap:10px;
    margin-bottom:10px;
  }
  .show-title{font-weight:700;font-size:15px;}
  .show-date{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:var(--muted);
    text-transform:uppercase;
  }
  .show-metrics{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(100px,1fr));
    gap:10px;
    font-family:'IBM Plex Mono', monospace;
  }
  .metric-label{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:0.05em;}
  .metric-value{font-size:15px;font-weight:600;}
  .profit-strip{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-top:14px;
    padding:10px 14px;
    font-family:'IBM Plex Mono', monospace;
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:0.05em;
    font-weight:700;
  }
  .profit-strip span:first-child{font-size:10.5px;color:var(--muted);letter-spacing:0.06em;}
  .profit-strip.gain{background:rgba(31,158,140,0.1);color:var(--gain);}
  .profit-strip.gain span:last-child{color:var(--gain);font-size:16px;}
  .profit-strip.loss{background:rgba(255,77,46,0.08);color:var(--hype);}
  .profit-strip.loss span:last-child{color:var(--hype);font-size:16px;}

  footer{
    text-align:center;
    padding:24px;
    font-family:'IBM Plex Mono', monospace;
    font-size:10.5px;
    color:var(--muted);
    letter-spacing:0.05em;
  }

  .toast{
    position:fixed;
    bottom:24px;
    left:50%;
    transform:translateX(-50%) translateY(20px);
    background:var(--ink);
    color:var(--paper);
    padding:12px 22px;
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:0.05em;
    border-left:3px solid var(--hype);
    opacity:0;
    pointer-events:none;
    transition:all .25s ease;
    z-index:100;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

  /* ---------- Invoices & Files ---------- */
  .files-block{margin-top:38px;padding-top:26px;border-top:3px solid var(--ink);}
  .files-tabs{display:flex;gap:0;margin-bottom:14px;border:1px solid var(--ink);width:max-content;max-width:100%;}
  .files-tab{
    background:var(--card);border:none;border-right:1px solid var(--ink);color:var(--ink);cursor:pointer;
    font-family:'IBM Plex Mono', monospace;font-size:12px;text-transform:uppercase;letter-spacing:0.06em;font-weight:600;
    padding:10px 18px;display:flex;align-items:center;gap:8px;
  }
  .files-tab:last-child{border-right:none;}
  .files-tab.active{background:var(--ink);color:var(--paper);}
  .files-tab-count{font-size:10.5px;padding:1px 7px;border:1px solid currentColor;opacity:.8;}
  .files-drop{
    display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
    background:var(--card);border:1.5px dashed var(--line);padding:18px 22px;margin-bottom:16px;transition:all .15s ease;
  }
  .files-drop.dragging{border-color:var(--hype);background:#FFF4F1;}
  .files-drop.disabled{opacity:.6;}
  .files-drop-title{font-family:'Anton', sans-serif;text-transform:uppercase;font-size:17px;letter-spacing:0.3px;}
  .files-drop-sub{font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.05em;margin-top:3px;}
  .files-upload-btn{display:inline-block;margin:0;}
  .files-month{
    display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap;
    border-bottom:1px solid var(--ink);padding:16px 2px 6px;margin-bottom:8px;
  }
  .files-month-name{font-family:'Anton', sans-serif;text-transform:uppercase;font-size:15px;letter-spacing:0.3px;}
  .files-month-stats{font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.04em;}
  .file-card{
    display:flex;align-items:flex-start;gap:14px;background:var(--card);border:1px solid var(--line);
    padding:13px 14px;margin-bottom:8px;box-shadow:var(--shadow);
  }
  .file-card:hover{border-color:var(--ink);}
  .file-badge{
    flex-shrink:0;width:46px;height:46px;display:flex;align-items:center;justify-content:center;
    font-family:'IBM Plex Mono', monospace;font-size:10.5px;font-weight:700;letter-spacing:0.04em;
    background:var(--paper-dim);border:1px solid var(--line);color:var(--ink);
  }
  .file-badge.inv{background:var(--ink);color:var(--paper);border-color:var(--ink);}
  .file-main{flex:1;min-width:0;}
  .file-title{font-weight:700;font-size:15px;line-height:1.25;word-break:break-word;}
  .file-facts{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 5px;}
  .fact{
    font-family:'IBM Plex Mono', monospace;font-size:11px;padding:2px 8px;border:1px solid var(--line);
    background:var(--paper);white-space:nowrap;
  }
  .fact.strong{border-color:var(--ink);font-weight:700;}
  .fact.money{background:var(--ink);color:var(--paper);border-color:var(--ink);font-weight:700;}
  .fact.missing{color:var(--muted);border-style:dashed;cursor:pointer;}
  .fact.logged{color:var(--gain);border-color:var(--gain);}
  .file-meta{font-family:'IBM Plex Mono', monospace;font-size:10.5px;color:var(--muted);overflow-wrap:anywhere;}
  .file-note{font-size:12.5px;color:var(--ink);margin-top:4px;}
  .file-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;flex-shrink:0;max-width:300px;}
  .file-actions .btn-danger{padding:5px 9px;}
  .file-progress{height:4px;background:var(--paper-dim);margin-top:8px;overflow:hidden;}
  .file-progress span{display:block;height:100%;background:var(--hype);width:0;transition:width .2s ease;}
  .file-card.pending{border-style:dashed;}
  .files-empty{border:1px solid var(--line);background:var(--card);}
  @media(max-width:640px){
    .file-card{flex-wrap:wrap;}
    .file-actions{max-width:none;width:100%;justify-content:flex-start;}
    .files-drop{padding:14px;}
  }

  /* ---------- Modals ---------- */
  .dl-modal{position:fixed;inset:0;background:rgba(18,18,18,.72);z-index:1000;display:none;align-items:center;justify-content:center;padding:18px;}
  .dl-modal.open{display:flex;}
  .dl-modal-card{background:var(--card);border:1px solid var(--ink);border-top:3px solid var(--hype);width:100%;max-width:560px;max-height:92vh;overflow:auto;padding:20px 22px;}
  .dl-modal-card.wide{max-width:900px;}
  .dl-modal-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px;}
  .dl-modal-title{font-family:'Anton', sans-serif;text-transform:uppercase;font-size:20px;letter-spacing:0.3px;word-break:break-word;}
  .dl-modal-sub{font-family:'IBM Plex Mono', monospace;font-size:11px;color:var(--muted);margin-top:3px;word-break:break-all;}
  .dl-modal-actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:14px;}
  .dl-modal-actions a.btn{text-decoration:none;display:inline-block;}
  .file-view-body{background:var(--paper-dim);border:1px solid var(--line);min-height:200px;display:flex;align-items:center;justify-content:center;}
  .file-view-body img{max-width:100%;max-height:70vh;display:block;}
  .file-view-body iframe{width:100%;height:70vh;border:none;background:#fff;}
  .file-view-msg{font-family:'IBM Plex Mono', monospace;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:0.05em;padding:40px 20px;text-align:center;}

  @media (prefers-reduced-motion: reduce){
    *{transition:none !important;}
  }
</style>

<!-- Firebase sync for multi-device Business Tracker -->
<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore-compat.js"></script>
<style>
  .cloud-login-overlay{position:fixed;inset:0;background:rgba(18,18,18,.96);z-index:99999;display:flex;align-items:center;justify-content:center;padding:24px;}
  .cloud-login-card{width:100%;max-width:390px;background:#fff;border:1px solid #D8D3C6;padding:28px;box-shadow:0 20px 80px rgba(0,0,0,.35);font-family:'Space Grotesk',sans-serif;}
  .cloud-login-title{font-family:'Anton',sans-serif;font-size:25px;text-transform:uppercase;margin:0 0 6px;color:#121212;}
  .cloud-login-sub{font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#8A857A;margin:0 0 18px;line-height:1.5;}
  .cloud-login-card input{width:100%;margin:0 0 10px;border:1px solid #D8D3C6;background:#F5F3EF;padding:11px 12px;font-size:14px;color:#121212;}
  .cloud-login-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}
  .cloud-login-row button{flex:1;min-width:130px;font-family:'IBM Plex Mono',monospace;font-size:12px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;padding:11px 12px;border:none;cursor:pointer;}
  .cloud-login-primary{background:#121212;color:#F5F3EF;}
  .cloud-login-secondary{background:#F5F3EF;color:#121212;border:1px solid #D8D3C6!important;}
  .cloud-login-error{min-height:18px;color:#FF4D2E;font-size:12px;margin-top:8px;}
  .cloud-sync-pill{position:fixed;right:14px;bottom:14px;background:#121212;color:#F5F3EF;border-left:3px solid #FF4D2E;padding:9px 12px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;z-index:90000;box-shadow:0 4px 20px rgba(0,0,0,.18);}
  .cloud-sync-pill button{margin-left:8px;background:transparent;color:#F5F3EF;border:1px solid #555;padding:3px 7px;font-size:10px;cursor:pointer;}
</style>

</head>
<body>

<div class="cloud-login-overlay" id="cloudLoginOverlay">
  <div class="cloud-login-card">
    <div class="cloud-login-title">DROP LEDGER CLOUD</div>
    <p class="cloud-login-sub">Enter the shared Murt Resell password. Your tracker will sync on every device.</p>
    <input type="password" id="cloudPassword" placeholder="Password" autocomplete="current-password">
    <div class="cloud-login-row">
      <button class="cloud-login-primary" id="cloudSignInBtn">Unlock</button>
    </div>
    <div class="cloud-login-error" id="cloudLoginError"></div>
  </div>
</div>
<div class="cloud-sync-pill" id="cloudSyncPill" style="display:none;">Cloud: connecting...</div>


<header>
  <div class="header-row">
    <div class="brand">DROP<span class="dot">·</span>LEDGER</div>
    <div class="tagline">Live Auction Ops — Expenses &amp; Show Analytics</div>
    <a href="../" style="color:#F5F3EF;text-decoration:none;border:1px solid #3A3A3A;padding:8px 12px;font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.05em;">← StreamPack</a>
  </div>
  <nav>
    <button data-view="dashboard" class="active">Dashboard</button>
    <button data-view="expenses">Expenses</button>
    <button data-view="shows">Shows</button>
    <button data-view="employees">Employees</button>
    <button data-view="inventory">Inventory</button>
    <button data-view="data">Backup</button>
  </nav>
</header>

<div class="month-bar-outer">
  <div class="month-bar-inner">
    <div class="period-picker">
      <span class="month-bar-label">View Profit By</span>
      <select id="period-mode">
        <option value="month">Month</option>
        <option value="year">Year</option>
        <option value="all">All Time</option>
      </select>
      <select id="period-year"></select>
      <input type="month" id="period-month">
      <button class="btn btn-primary btn-small" id="apply-period-btn">Apply</button>
      <button class="btn btn-ghost btn-small" id="jump-current-month-btn">Current Month</button>
      <span class="period-now" id="period-now-label">Viewing: —</span>
    </div>
    <span class="month-bar-label">Quick Months</span>
    <div class="month-pills" id="month-pills"></div>
    <div class="month-add">
      <input type="month" id="new-month-input">
      <button class="btn btn-ghost btn-small" id="add-month-btn">+ Add Month</button>
    </div>
  </div>
</div>

<main>

  <!-- ============ DASHBOARD ============ -->
  <section class="view active" id="view-dashboard">
    <h2 class="section-title">Overview</h2>
    <p class="section-sub" id="dash-range">All-time totals</p>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value gain mono" id="stat-revenue">$0.00</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total Expenses</div>
        <div class="stat-value loss mono" id="stat-expenses">$0.00</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Net Profit</div>
        <div class="stat-value mono" id="stat-net">$0.00</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Shows Logged</div>
        <div class="stat-value mono" id="stat-shows">0</div>
      </div>
    </div>

    <div class="two-col">
      <div class="receipt">
        <div class="receipt-title">Business Summary</div>
        <div class="receipt-sub" id="receipt-date">—</div>
        <hr class="receipt-divider">
        <div class="receipt-row"><span>Gross Revenue (all shows)</span><span class="r-amt pos" id="rc-revenue">$0.00</span></div>
        <div class="receipt-row"><span>Total Expenses</span><span class="r-amt neg" id="rc-expenses">$0.00</span></div>
        <div class="receipt-row"><span>Avg. Revenue / Show</span><span id="rc-avg-rev">$0.00</span></div>
        <div class="receipt-row"><span>Avg. Items Sold / Show</span><span id="rc-avg-items">0</span></div>
        <hr class="receipt-divider">
        <div class="receipt-row total"><span>NET PROFIT</span><span id="rc-net">$0.00</span></div>
        <div class="receipt-foot">DROP LEDGER · KEEP THIS RECEIPT</div>
      </div>

      <div class="bars-wrap">
        <h3 style="font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin:0 0 16px;">Expenses by Category</h3>
        <div id="category-bars"></div>
      </div>
    </div>
  </section>

  <!-- ============ EXPENSES ============ -->
  <section class="view" id="view-expenses">
    <h2 class="section-title">Expenses</h2>
    <p class="section-sub">Uber, food, packing supplies, boxes, inventory, fees — anything that costs you money.</p>
    <p class="section-sub mono" id="expenses-context" style="color:var(--hype);">Showing: All Time</p>

    <div class="form-card" style="border-color:var(--ink);background:var(--paper-dim);">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
        <div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin-bottom:4px;">Employee Pay — Auto-Synced from Employees Tab</div>
          <div style="font-size:12px;color:var(--muted);">Updates automatically as you log show pay or extra work hours. Comes out of this month's profit, not each show's individual profit. Not manually editable here — go to the Employees tab to change it.</div>
        </div>
        <div class="mono" id="expenses-employee-pay-total" style="font-size:22px;font-weight:700;white-space:nowrap;">$0.00</div>
      </div>
    </div>

    <div class="form-card">
      <div class="form-grid">
        <div>
          <label for="exp-date">Date</label>
          <input type="date" id="exp-date">
        </div>
        <div>
          <label for="exp-category">Category</label>
          <select id="exp-category"></select>
        </div>
        <div>
          <label for="exp-amount">Amount ($)</label>
          <input type="number" id="exp-amount" step="0.01" min="0" placeholder="0.00">
        </div>
        <div>
          <label for="exp-show">Link to Deal (optional)</label>
          <select id="exp-show"><option value="">— None —</option></select>
        </div>
      </div>
      <div class="form-grid" style="grid-template-columns:1fr;">
        <div>
          <label for="exp-desc">Description</label>
          <input type="text" id="exp-desc" placeholder="e.g. Uber for packer to warehouse">
        </div>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button class="btn btn-primary" id="add-expense-btn">+ Add Expense</button>
        <button class="btn btn-ghost" id="add-category-btn">+ New Category</button>
      </div>
    </div>

    <div class="toolbar">
      <div>
        <select id="exp-filter-category" style="width:auto;display:inline-block;">
          <option value="">All Categories</option>
        </select>
      </div>
      <div class="toolbar-actions">
        <span class="section-sub" id="exp-count" style="margin:0;">0 entries</span>
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Date</th><th>Category</th><th>Description</th><th>Linked Deal</th><th>Amount</th><th></th></tr>
        </thead>
        <tbody id="expenses-tbody"></tbody>
      </table>
      <div class="empty-state" id="expenses-empty" style="display:none;">No expenses yet — add your first one above.</div>
    </div>
  </section>

  <!-- ============ SHOWS ============ -->
  <section class="view" id="view-shows">
    <h2 class="section-title">Deal Analytics</h2>
    <p class="section-sub">Log every TikTok live auction, private buyer deal, or bulk order to track what's actually working.</p>
    <p class="section-sub mono" id="shows-context" style="color:var(--hype);">Showing: All Time</p>

    <div class="form-card">
      <div class="form-grid">
        <div>
          <label for="show-date">Date</label>
          <input type="date" id="show-date">
        </div>
        <div>
          <label for="show-type">Deal Type</label>
          <select id="show-type">
            <option value="Show">Show</option>
            <option value="Private Buyer Deal">Private Buyer Deal</option>
            <option value="Bulk Order">Bulk Order</option>
          </select>
        </div>
        <div>
          <label for="show-title">Title / Name</label>
          <input type="text" id="show-title" placeholder="e.g. Friday Night Heat Drop, private buyer, bulk lot">
        </div>
        <div>
          <label for="show-revenue">Revenue ($)</label>
          <input type="number" id="show-revenue" step="0.01" min="0" placeholder="0.00">
        </div>
        <div>
          <label for="show-items">Items Sold</label>
          <input type="number" id="show-items" min="0" placeholder="0">
        </div>
      </div>
      <div class="form-grid">
        <div>
          <label for="show-viewers">Peak Viewers</label>
          <input type="number" id="show-viewers" min="0" placeholder="0">
        </div>
        <div>
          <label for="show-duration">Duration (minutes)</label>
          <input type="number" id="show-duration" min="0" placeholder="0">
        </div>
        <div>
          <label for="show-cost">Show Cost ($)</label>
          <input type="number" id="show-cost" step="0.01" min="0" placeholder="0.00">
        </div>
        <div>
          <label for="show-worker-rate">Worker Rate ($/hr)</label>
          <input type="number" id="show-worker-rate" step="0.01" min="0" placeholder="20.00">
        </div>
        <div>
          <label for="show-employees">Employee Name(s)</label>
          <input type="text" id="show-employees" list="employee-names-list" placeholder="e.g. Ali, Omar">
          <datalist id="employee-names-list"></datalist>
        </div>
        <div>
          <label for="pplus-rate">P+ Commission (%)</label>
          <input type="number" id="pplus-rate" step="0.1" min="0" placeholder="5">
        </div>
        <div>
          <label for="show-buyers">Unique Buyers</label>
          <input type="number" id="show-buyers" min="0" placeholder="0">
        </div>
      </div>
      <div class="profit-preview" id="profit-preview">
        <span class="pp-label">Gross profit for this deal</span>
        <span class="pp-value" id="profit-preview-value">$0.00</span>
      </div>
      <div class="profit-preview" id="worker-preview" style="margin-top:-8px;">
        <span class="pp-label">Worker pay preview (not deducted)</span>
        <span class="pp-value" id="worker-preview-value">$0.00</span>
      </div>
      <div class="form-grid" style="grid-template-columns:1fr;">
        <div>
          <label for="show-notes">Notes</label>
          <textarea id="show-notes" rows="2" placeholder="What sold well, what flopped, anything to remember for next time"></textarea>
        </div>
      </div>
      <button class="btn btn-primary" id="add-show-btn">+ Log Deal</button>
      <button class="btn btn-ghost" id="cancel-edit-show-btn" style="display:none;margin-left:8px;">Cancel Edit</button>
    </div>

    <div class="toolbar">
      <p class="section-sub" style="margin:0;" id="show-count">0 shows logged</p>
    </div>

    <div id="shows-list"></div>
    <div class="empty-state" id="shows-empty" style="display:none;">No deals logged yet — add your first one above.</div>
  </section>

  <!-- ============ EMPLOYEES ============ -->
  <section class="view" id="view-employees">
    <h2 class="section-title">Employees</h2>
    <p class="section-sub">Track worker pay from each show, private buyer deal, or bulk order. Pay is split evenly if you add more than one employee name.</p>
    <p class="section-sub mono" id="employees-context" style="color:var(--hype);">Showing: All Time</p>

    <div class="form-card">
      <div class="form-grid">
        <div>
          <label for="employee-name-input">Add Employee Name</label>
          <input type="text" id="employee-name-input" placeholder="e.g. Ali">
        </div>
      </div>
      <button class="btn btn-primary" id="add-employee-btn">+ Add Employee</button>
      <button class="btn btn-ghost" id="refresh-employees-btn" style="margin-left:8px;">Refresh Pay</button>
    </div>

    <div class="form-card">
      <h3 style="font-family:'IBM Plex Mono',monospace;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;margin-top:0;">Add Extra Work Hours</h3>
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px;">Use this for packing, inventory, sorting, setup, or any work that is not tied to a show.</p>
      <div class="form-grid">
        <div>
          <label for="extra-work-date">Date</label>
          <input type="date" id="extra-work-date">
        </div>
        <div>
          <label for="extra-employee-name">Employee Name</label>
          <input type="text" id="extra-employee-name" list="employee-names-list" placeholder="e.g. Ali">
        </div>
        <div>
          <label for="extra-work-type">Work Type</label>
          <select id="extra-work-type">
            <option value="Packing">Packing</option>
            <option value="Inventory">Inventory</option>
            <option value="Sorting">Sorting</option>
            <option value="Setup">Setup</option>
            <option value="Other Work">Other Work</option>
          </select>
        </div>
        <div>
          <label for="extra-work-hours">Hours</label>
          <input type="number" id="extra-work-hours" step="0.25" min="0" placeholder="0">
        </div>
        <div>
          <label for="extra-work-rate">Rate ($/hr)</label>
          <input type="number" id="extra-work-rate" step="0.01" min="0" placeholder="20.00">
        </div>
      </div>
      <div class="form-grid" style="grid-template-columns:1fr;">
        <div>
          <label for="extra-work-notes">Notes</label>
          <input type="text" id="extra-work-notes" placeholder="e.g. packed orders after Friday show">
        </div>
      </div>
      <button class="btn btn-primary" id="add-extra-work-btn">+ Add Extra Work Pay</button>
    </div>

    <div class="toolbar">
      <p class="section-sub" style="margin:0;" id="employee-count">0 employees</p>
      <p class="section-sub" style="margin:0;">Total Employee Pay: <span class="mono" id="employee-total-pay" style="color:var(--ink);font-weight:700;">$0.00</span></p>
    </div>

    <div class="table-wrap" style="margin-bottom:22px;">
      <table>
        <thead>
          <tr><th>Employee</th><th>Deals Worked</th><th>Hourly Pay</th><th>P+ Commission</th><th>Total Pay</th><th></th></tr>
        </thead>
        <tbody id="employees-summary-tbody"></tbody>
      </table>
      <div class="empty-state" id="employees-empty" style="display:none;">No employees yet — add a name or assign one in a deal.</div>
    </div>

    <h2 class="section-title" style="font-size:16px;">Pay Log</h2>
    <p class="section-sub">Every deal where an employee was assigned.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Date</th><th>Employee</th><th>Deal / Work</th><th>Hourly</th><th>Commission</th><th>Total</th><th></th></tr>
        </thead>
        <tbody id="employees-log-tbody"></tbody>
      </table>
      <div class="empty-state" id="employees-log-empty" style="display:none;">No employee pay logged for this month yet.</div>
    </div>
  </section>

  <!-- ============ INVENTORY ============ -->
  <section class="view" id="view-inventory">
    <h2 class="section-title">Inventory Purchases</h2>
    <p class="section-sub">Reference only — what you've bought to resell. This does NOT count toward your monthly revenue or profit numbers.</p>
    <p class="section-sub mono" id="inventory-context" style="color:var(--hype);">Showing: All Time</p>

    <div class="form-card">
      <div class="form-grid">
        <div>
          <label for="inv-date">Date Bought</label>
          <input type="date" id="inv-date">
        </div>
        <div>
          <label for="inv-item">Item / Product</label>
          <input type="text" id="inv-item" placeholder="e.g. Vintage Champion hoodie lot">
        </div>
        <div>
          <label for="inv-qty">Quantity</label>
          <input type="number" id="inv-qty" min="0" placeholder="1">
        </div>
        <div>
          <label for="inv-cost">Total Cost ($)</label>
          <input type="number" id="inv-cost" step="0.01" min="0" placeholder="0.00">
        </div>
      </div>
      <div class="form-grid">
        <div>
          <label for="inv-vendor">Vendor / Source (optional)</label>
          <input type="text" id="inv-vendor" placeholder="e.g. thrift store, wholesaler name">
        </div>
      </div>
      <div class="form-grid" style="grid-template-columns:1fr;">
        <div>
          <label for="inv-notes">Notes</label>
          <input type="text" id="inv-notes" placeholder="condition, sizes, anything worth remembering">
        </div>
      </div>
      <button class="btn btn-primary" id="add-inventory-btn">+ Add Inventory Purchase</button>
    </div>

    <div class="toolbar">
      <p class="section-sub" style="margin:0;" id="inventory-count">0 purchases logged</p>
      <p class="section-sub" style="margin:0;">Reference Total: <span class="mono" id="inventory-total" style="color:var(--ink);font-weight:700;">$0.00</span></p>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Date</th><th>Item</th><th>Qty</th><th>Vendor</th><th>Notes</th><th>Cost</th><th></th></tr>
        </thead>
        <tbody id="inventory-tbody"></tbody>
      </table>
      <div class="empty-state" id="inventory-empty" style="display:none;">No inventory purchases logged yet.</div>
    </div>

    <!-- ===== INVOICES & FILES ===== -->
    <div class="files-block" id="files-block">
      <h2 class="section-title">Invoices &amp; Files</h2>
      <p class="section-sub">Upload invoices from your orders and any other paperwork. Each file gets a quick summary automatically and syncs to every device.</p>

      <div class="files-tabs">
        <button class="files-tab active" data-files-tab="invoice">Invoices <span class="files-tab-count" id="files-count-invoice">0</span></button>
        <button class="files-tab" data-files-tab="other">Other Files <span class="files-tab-count" id="files-count-other">0</span></button>
      </div>

      <div class="files-drop" id="files-drop">
        <div>
          <div class="files-drop-title" id="files-drop-title">Drop invoices here</div>
          <div class="files-drop-sub" id="files-drop-sub">PDFs, photos or screenshots of invoices from your orders · pick several at once</div>
        </div>
        <label class="btn btn-primary files-upload-btn">
          <span id="files-upload-label">+ Upload Invoice</span>
          <input type="file" id="files-input" multiple style="display:none;">
        </label>
      </div>

      <div class="toolbar">
        <input type="text" id="files-search" placeholder="Search vendor, invoice #, file name..." style="max-width:340px;">
        <p class="section-sub" style="margin:0;" id="files-summary-line">—</p>
      </div>

      <div id="files-list"></div>
      <div class="empty-state files-empty" id="files-empty" style="display:none;">No invoices uploaded yet.</div>
    </div>
  </section>

  <!-- ============ BACKUP ============ -->
  <section class="view" id="view-data">
    <h2 class="section-title">Backup &amp; Restore</h2>
    <p class="section-sub">Your data lives in this browser only. Export a backup regularly, especially before clearing browser data or switching computers.</p>

    <div class="form-card">
      <h3 style="font-family:'IBM Plex Mono',monospace;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;margin-top:0;">Export</h3>
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px;">Download everything — expenses, shows, categories — as one file.</p>
      <button class="btn btn-primary" id="export-json-btn">Download Backup (.json)</button>
      <button class="btn btn-ghost" id="export-csv-btn" style="margin-left:8px;">Export Expenses (.csv)</button>
      <button class="btn btn-ghost" id="export-shows-csv-btn" style="margin-left:8px;">Export Shows (.csv)</button>
      <button class="btn btn-ghost" id="export-inventory-csv-btn" style="margin-left:8px;">Export Inventory (.csv)</button>
      <button class="btn btn-ghost" id="export-employees-csv-btn" style="margin-left:8px;">Export Employees (.csv)</button>
    </div>

    <div class="form-card">
      <h3 style="font-family:'IBM Plex Mono',monospace;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;margin-top:0;">Import</h3>
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px;">Restore from a previously downloaded backup file. This replaces all current data.</p>
      <input type="file" id="import-file" accept=".json" style="margin-bottom:12px;">
      <br>
      <button class="btn btn-ghost" id="import-json-btn">Restore from Backup</button>
    </div>

    <div class="form-card" style="border-color:var(--hype);">
      <h3 style="font-family:'IBM Plex Mono',monospace;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;margin-top:0;color:var(--hype);">Danger Zone</h3>
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px;">Permanently erase all expenses and shows from this browser. Export a backup first.</p>
      <button class="btn btn-danger" id="clear-all-btn">Erase All Data</button>
    </div>
  </section>

</main>

<footer>DROP LEDGER — data is stored locally in this browser. Back up often.</footer>
<div class="toast" id="toast"></div>

<!-- File viewer -->
<div class="dl-modal" id="file-view-modal">
  <div class="dl-modal-card wide">
    <div class="dl-modal-head">
      <div>
        <div class="dl-modal-title" id="file-view-title">—</div>
        <div class="dl-modal-sub" id="file-view-sub">—</div>
      </div>
      <button class="btn btn-ghost btn-small" data-close-modal>Close</button>
    </div>
    <div class="file-view-body" id="file-view-body"></div>
    <div class="dl-modal-actions">
      <a class="btn btn-ghost" id="file-view-open" target="_blank" rel="noopener">Open in New Tab</a>
      <a class="btn btn-primary" id="file-view-download">Download</a>
    </div>
  </div>
