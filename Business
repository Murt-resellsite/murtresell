<script>
(function(){
  "use strict";

  var DEFAULT_CATEGORIES = ["Uber / Delivery", "Food", "Packing Supplies", "Boxes & Shipping", "Platform Fees", "Other"];
  var LS_EXPENSES = "dropledger_expenses_v1";
  var LS_SHOWS = "dropledger_shows_v1";
  var LS_CATEGORIES = "dropledger_categories_v1";
  var LS_INVENTORY = "dropledger_inventory_v1";
  var LS_MONTHS = "dropledger_months_v1";
  var LS_CURRENT_MONTH = "dropledger_current_month_v1";
  var LS_WORKER_RATE = "dropledger_worker_rate_v1";
  var LS_COMMISSION_RATE = "dropledger_commission_rate_v1";
  var LS_EMPLOYEES = "dropledger_employees_v1";
  var LS_EMPLOYEE_WORK = "dropledger_employee_work_v1";

  var state = { expenses: [], shows: [], categories: [], inventory: [], employees: [], employeeWork: [], months: [], currentMonth: "all", workerRate: 20, commissionRate: 5 };
  var editingShowId = null;

  // toISOString() reports UTC time. For anyone west of UTC (e.g. US timezones),
  // for a chunk of every evening the UTC date/month is already the NEXT day —
  // so "today" computed from toISOString() can silently be tomorrow. That was
  // pushing entries added late at night into the wrong month. This uses the
  // browser's actual local date instead.
  function localDateStr(d){
    d = d || new Date();
    var y = d.getFullYear();
    var m = String(d.getMonth()+1).padStart(2,'0');
    var day = String(d.getDate()).padStart(2,'0');
    return y + '-' + m + '-' + day;
  }

  function getMonthKey(dateStr){ return dateStr ? dateStr.slice(0,7) : ""; }
  function fmtMonthLabel(mkey){
    if(mkey === "all") return "All Time";
    if(mkey && mkey.indexOf("year:") === 0) return mkey.replace("year:", "") + " Year";
    var parts = mkey.split("-");
    if(parts.length !== 2) return mkey;
    var months = ["January","February","March","April","May","June","July","August","September","October","November","December"];
    return months[parseInt(parts[1],10)-1] + " " + parts[0];
  }
  function todayMonthKey(){ return localDateStr().slice(0,7); }
  function getYearKey(dateStr){ return dateStr ? dateStr.slice(0,4) : ""; }
  function inSelectedPeriod(dateStr){
    if(state.currentMonth === "all") return true;
    if(!dateStr) return false;
    if(state.currentMonth && state.currentMonth.indexOf("year:") === 0){
      return getYearKey(dateStr) === state.currentMonth.replace("year:", "");
    }
    return getMonthKey(dateStr) === state.currentMonth;
  }
  function periodYearValue(){
    if(state.currentMonth && state.currentMonth.indexOf("year:") === 0) return state.currentMonth.replace("year:", "");
    if(state.currentMonth && state.currentMonth !== "all") return state.currentMonth.slice(0,4);
    return new Date().getFullYear().toString();
  }

  function loadState(){
    try{
      state.expenses = JSON.parse(localStorage.getItem(LS_EXPENSES) || "[]");
    }catch(e){ state.expenses = []; }
    try{
      state.shows = JSON.parse(localStorage.getItem(LS_SHOWS) || "[]");
    }catch(e){ state.shows = []; }
    try{
      var cats = JSON.parse(localStorage.getItem(LS_CATEGORIES) || "null");
      state.categories = cats && cats.length ? cats : DEFAULT_CATEGORIES.slice();
    }catch(e){ state.categories = DEFAULT_CATEGORIES.slice(); }
    try{
      var months = JSON.parse(localStorage.getItem(LS_MONTHS) || "[]");
      state.months = Array.isArray(months) ? months : [];
    }catch(e){ state.months = []; }
    try{
      var inv = JSON.parse(localStorage.getItem(LS_INVENTORY) || "[]");
      state.inventory = Array.isArray(inv) ? inv : [];
    }catch(e){ state.inventory = []; }
    try{
      var emps = JSON.parse(localStorage.getItem(LS_EMPLOYEES) || "[]");
      state.employees = Array.isArray(emps) ? emps : [];
    }catch(e){ state.employees = []; }
    try{
      var work = JSON.parse(localStorage.getItem(LS_EMPLOYEE_WORK) || "[]");
      state.employeeWork = Array.isArray(work) ? work : [];
    }catch(e){ state.employeeWork = []; }
    state.currentMonth = localStorage.getItem(LS_CURRENT_MONTH) || todayMonthKey();
    var savedWorkerRate = parseFloat(localStorage.getItem(LS_WORKER_RATE));
    state.workerRate = isNaN(savedWorkerRate) ? 20 : savedWorkerRate;
    var savedCommissionRate = parseFloat(localStorage.getItem(LS_COMMISSION_RATE));
    state.commissionRate = isNaN(savedCommissionRate) ? 5 : savedCommissionRate;
  }

  function saveExpenses(){ localStorage.setItem(LS_EXPENSES, JSON.stringify(state.expenses)); }
  function saveShows(){ localStorage.setItem(LS_SHOWS, JSON.stringify(state.shows)); }
  function saveCategories(){ localStorage.setItem(LS_CATEGORIES, JSON.stringify(state.categories)); }
  function saveInventory(){ localStorage.setItem(LS_INVENTORY, JSON.stringify(state.inventory)); }
  function saveMonths(){ localStorage.setItem(LS_MONTHS, JSON.stringify(state.months)); }
  function saveCurrentMonth(){ localStorage.setItem(LS_CURRENT_MONTH, state.currentMonth); }
  function saveWorkerRate(){ localStorage.setItem(LS_WORKER_RATE, String(state.workerRate)); }
  function saveCommissionRate(){ localStorage.setItem(LS_COMMISSION_RATE, String(state.commissionRate)); }
  function saveEmployees(){ localStorage.setItem(LS_EMPLOYEES, JSON.stringify(state.employees)); }
  function saveEmployeeWork(){ localStorage.setItem(LS_EMPLOYEE_WORK, JSON.stringify(state.employeeWork)); }

  function computeMonthsUnion(){
    var set = {};
    state.months.forEach(function(m){ if(m) set[m] = true; });
    state.expenses.forEach(function(e){ if(e.date) set[getMonthKey(e.date)] = true; });
    state.shows.forEach(function(s){ if(s.date) set[getMonthKey(s.date)] = true; });
    state.inventory.forEach(function(i){ if(i.date) set[getMonthKey(i.date)] = true; });
    state.employeeWork.forEach(function(w){ if(w.date) set[getMonthKey(w.date)] = true; });
    var arr = Object.keys(set).filter(Boolean);
    arr.sort();
    // Only write back if the list actually changed. init() calls this on
    // every load AND every time a remote cloud update comes in — writing
    // unconditionally here meant every device that received an update would
    // immediately re-save right back, which the other device would then see
    // as a new update and re-save again, forever. That endless "saving...
    // synced... saving... synced..." loop was this exact bug.
    var changed = arr.length !== state.months.length || arr.some(function(m, i){ return m !== state.months[i]; });
    state.months = arr;
    if(changed) saveMonths();
  }

  function ensureMonthExists(mkey){
    if(mkey && state.months.indexOf(mkey) === -1){
      state.months.push(mkey);
      state.months.sort();
      saveMonths();
      renderMonthBar();
    }
  }

  function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,8); }

  function fmtMoney(n){
    n = Number(n) || 0;
    return "$" + n.toLocaleString("en-US", {minimumFractionDigits:2, maximumFractionDigits:2});
  }
  function fmtDate(d){
    if(!d) return "—";
    var parts = d.split("-");
    if(parts.length !== 3) return d;
    var months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
    return months[parseInt(parts[1],10)-1] + " " + parseInt(parts[2],10) + ", " + parts[0];
  }

  function toast(msg){
    var t = document.getElementById("toast");
    t.textContent = msg;
    t.classList.add("show");
    clearTimeout(toast._timer);
    toast._timer = setTimeout(function(){ t.classList.remove("show"); }, 2200);
  }

  /* ---------------- Navigation ---------------- */
  var navButtons = document.querySelectorAll("nav button");
  navButtons.forEach(function(btn){
    btn.addEventListener("click", function(){
      navButtons.forEach(function(b){ b.classList.remove("active"); });
      btn.classList.add("active");
      document.querySelectorAll(".view").forEach(function(v){ v.classList.remove("active"); });
      document.getElementById("view-" + btn.dataset.view).classList.add("active");
      if(btn.dataset.view === "dashboard") renderDashboard();
    });
  });

  /* ---------------- Month bar ---------------- */
  function renderMonthBar(){
    var wrap = document.getElementById("month-pills");
    wrap.innerHTML = "";

    var allPill = document.createElement("button");
    allPill.className = "month-pill all-time" + (state.currentMonth === "all" ? " active" : "");
    allPill.textContent = "All Time";
    allPill.addEventListener("click", function(){ switchMonth("all"); });
    wrap.appendChild(allPill);

    getAvailableYears().forEach(function(year){
      var pill = document.createElement("button");
      var key = "year:" + year;
      pill.className = "month-pill" + (state.currentMonth === key ? " active" : "");
      pill.textContent = year + " Year";
      pill.addEventListener("click", function(){ switchMonth(key); });
      wrap.appendChild(pill);
    });

    state.months.slice().sort().forEach(function(mkey){
      var hasData = state.expenses.some(function(e){ return getMonthKey(e.date) === mkey; }) ||
                    state.shows.some(function(s){ return getMonthKey(s.date) === mkey; });
      var pill = document.createElement("button");
      pill.className = "month-pill" + (state.currentMonth === mkey ? " active" : "");
      pill.innerHTML = escapeHtml(fmtMonthLabel(mkey)) + (hasData ? "" : ' <span class="del-x" data-del-month="'+mkey+'" title="Remove empty month">&times;</span>');
      pill.addEventListener("click", function(ev){
        if(ev.target.dataset.delMonth) return;
        switchMonth(mkey);
      });
      wrap.appendChild(pill);
    });

    wrap.querySelectorAll("[data-del-month]").forEach(function(x){
      x.addEventListener("click", function(ev){
        ev.stopPropagation();
        var mkey = x.dataset.delMonth;
        state.months = state.months.filter(function(m){ return m !== mkey; });
        saveMonths();
        if(state.currentMonth === mkey) switchMonth("all");
        else renderMonthBar();
      });
    });
  }

  function getAvailableYears(){
    var years = {};
    state.months.forEach(function(m){ if(m) years[m.slice(0,4)] = true; });
    state.expenses.forEach(function(e){ if(e.date) years[getYearKey(e.date)] = true; });
    state.shows.forEach(function(s){ if(s.date) years[getYearKey(s.date)] = true; });
    state.inventory.forEach(function(i){ if(i.date) years[getYearKey(i.date)] = true; });
    state.employeeWork.forEach(function(w){ if(w.date) years[getYearKey(w.date)] = true; });
    years[new Date().getFullYear().toString()] = true;
    return Object.keys(years).filter(Boolean).sort();
  }

  function updatePeriodControls(){
    var mode = document.getElementById("period-mode");
    var yearSel = document.getElementById("period-year");
    var monthInput = document.getElementById("period-month");
    if(!mode || !yearSel || !monthInput) return;
    var years = getAvailableYears();
    var chosenYear = periodYearValue();
    yearSel.innerHTML = "";
    years.forEach(function(y){
      var opt = document.createElement("option");
      opt.value = y; opt.textContent = y;
      yearSel.appendChild(opt);
    });
    if(years.indexOf(chosenYear) === -1){
      var opt = document.createElement("option");
      opt.value = chosenYear; opt.textContent = chosenYear;
      yearSel.appendChild(opt);
    }
    yearSel.value = chosenYear;
    if(state.currentMonth === "all") mode.value = "all";
    else if(state.currentMonth && state.currentMonth.indexOf("year:") === 0) mode.value = "year";
    else mode.value = "month";
    monthInput.value = (state.currentMonth && state.currentMonth !== "all" && state.currentMonth.indexOf("year:") !== 0) ? state.currentMonth : todayMonthKey();
    yearSel.style.display = mode.value === "year" ? "inline-block" : "none";
    monthInput.style.display = mode.value === "month" ? "inline-block" : "none";
    document.getElementById("period-now-label").textContent = "Viewing: " + fmtMonthLabel(state.currentMonth);
  }

  function switchMonth(mkey){
    state.currentMonth = mkey;
    saveCurrentMonth();
    refreshAllViews();
  }

  // Single source of truth for "re-render everything that depends on
  // state.currentMonth." Several actions (switching a month tab, adding an
  // entry that auto-jumps you to a different month) change which period is
  // selected — if any of those forgot to refresh a tab, that tab would keep
  // showing stale data from whatever period was selected before. Routing
  // every one of those actions through this single function prevents that
  // class of bug instead of relying on each call site to remember every tab.
  function refreshAllViews(){
    renderMonthBar();
    updatePeriodControls();
    updateContextLabels();
    renderExpenses();
    renderShows();
    renderEmployees();
    renderInventory();
    renderDashboard();
  }

  function updateContextLabels(){
    var label = fmtMonthLabel(state.currentMonth);
    document.getElementById("dash-range").textContent = label + " totals";
    document.getElementById("expenses-context").textContent = "Showing: " + label;
    document.getElementById("shows-context").textContent = "Showing: " + label;
    document.getElementById("employees-context").textContent = "Showing: " + label;
    document.getElementById("inventory-context").textContent = "Showing: " + label;
  }

  document.getElementById("add-month-btn").addEventListener("click", function(){
    var input = document.getElementById("new-month-input");
    var val = input.value;
    if(!val){ toast("Pick a month first"); return; }
    ensureMonthExists(val);
    switchMonth(val);
    input.value = "";
    toast(fmtMonthLabel(val) + " added");
  });

  document.getElementById("period-mode").addEventListener("change", updatePeriodControls);
  document.getElementById("apply-period-btn").addEventListener("click", function(){
    var mode = document.getElementById("period-mode").value;
    if(mode === "all") switchMonth("all");
    else if(mode === "year") switchMonth("year:" + document.getElementById("period-year").value);
    else {
      var m = document.getElementById("period-month").value;
      if(!m){ toast("Pick a month first"); return; }
      ensureMonthExists(m);
      switchMonth(m);
    }
  });
  document.getElementById("jump-current-month-btn").addEventListener("click", function(){
    ensureMonthExists(todayMonthKey());
    switchMonth(todayMonthKey());
  });

  /* ---------------- Default date for forms ---------------- */
  function defaultDateForCurrentMonth(){
    if(state.currentMonth === "all" || !state.currentMonth) return localDateStr();
    if(state.currentMonth.indexOf("year:") === 0) return state.currentMonth.replace("year:", "") + "-01-01";
    if(state.currentMonth === todayMonthKey()) return localDateStr();
    return state.currentMonth + "-01";
  }


  function populateCategorySelects(){
    var expSelect = document.getElementById("exp-category");
    var filterSelect = document.getElementById("exp-filter-category");
    var currentFilter = filterSelect.value;
    expSelect.innerHTML = "";
    filterSelect.innerHTML = '<option value="">All Categories</option>';
    state.categories.forEach(function(cat){
      var o1 = document.createElement("option"); o1.value = cat; o1.textContent = cat;
      expSelect.appendChild(o1);
      var o2 = document.createElement("option"); o2.value = cat; o2.textContent = cat;
      filterSelect.appendChild(o2);
    });
    filterSelect.value = currentFilter;
  }

  function populateShowSelect(){
    var sel = document.getElementById("exp-show");
    var current = sel.value;
    sel.innerHTML = '<option value="">— None —</option>';
    state.shows.slice().sort(function(a,b){ return (b.date||"").localeCompare(a.date||""); }).forEach(function(show){
      var o = document.createElement("option");
      o.value = show.id;
      o.textContent = (show.title || "Untitled Show") + " (" + fmtDate(show.date) + ")";
      sel.appendChild(o);
    });
    sel.value = current;
  }

  /* ---------------- Add Category ---------------- */
  document.getElementById("add-category-btn").addEventListener("click", function(){
    var name = prompt("New expense category name:");
    if(!name) return;
    name = name.trim();
    if(!name) return;
    if(state.categories.indexOf(name) !== -1){
      toast("Category already exists");
      return;
    }
    state.categories.push(name);
    saveCategories();
    populateCategorySelects();
    document.getElementById("exp-category").value = name;
    toast("Category added: " + name);
  });

  /* ---------------- Add Expense ---------------- */
  document.getElementById("add-expense-btn").addEventListener("click", function(){
    var date = document.getElementById("exp-date").value || defaultDateForCurrentMonth();
    var category = document.getElementById("exp-category").value;
    var amount = parseFloat(document.getElementById("exp-amount").value);
    var showId = document.getElementById("exp-show").value;
    var desc = document.getElementById("exp-desc").value.trim();

    if(isNaN(amount) || amount <= 0){
      toast("Enter a valid amount");
      return;
    }

    state.expenses.push({
      id: uid(),
      date: date,
      category: category,
      amount: amount,
      showId: showId || null,
      description: desc
    });
    saveExpenses();

    var entryMonth = getMonthKey(date);
    ensureMonthExists(entryMonth);
    var switched = state.currentMonth !== "all" && state.currentMonth.indexOf("year:") !== 0 && state.currentMonth !== entryMonth;
    if(switched) state.currentMonth = entryMonth, saveCurrentMonth();

    document.getElementById("exp-amount").value = "";
    document.getElementById("exp-desc").value = "";
    document.getElementById("exp-date").value = defaultDateForCurrentMonth();

    refreshAllViews();
    toast(switched ? "Expense added to " + fmtMonthLabel(entryMonth) : "Expense added");
  });

  /* ---------------- Filter expenses ---------------- */
  document.getElementById("exp-filter-category").addEventListener("change", renderExpenses);

  /* ---------------- Render Expenses table ---------------- */
  function renderExpenses(){
    populateShowSelect();
    document.getElementById("expenses-employee-pay-total").textContent = fmtMoney(employeePayTotalForPeriod());
    var tbody = document.getElementById("expenses-tbody");
    var filter = document.getElementById("exp-filter-category").value;
    var list = state.expenses.slice().sort(function(a,b){ return (b.date||"").localeCompare(a.date||""); });
    if(state.currentMonth !== "all") list = list.filter(function(e){ return inSelectedPeriod(e.date); });
    list = list.filter(function(e){ return !isAutoShowExpense(e); });
    if(filter) list = list.filter(function(e){ return e.category === filter; });

    tbody.innerHTML = "";
    document.getElementById("expenses-empty").style.display = list.length ? "none" : "block";
    document.getElementById("exp-count").textContent = list.length + " entr" + (list.length===1?"y":"ies");

    var showMap = {};
    state.shows.forEach(function(s){ showMap[s.id] = s; });

    list.forEach(function(exp){
      var tr = document.createElement("tr");
      var linkedShow = exp.showId && showMap[exp.showId] ? showMap[exp.showId].title : "—";
      tr.innerHTML =
        '<td class="mono">' + fmtDate(exp.date) + '</td>' +
        '<td><span class="cat-tag">' + escapeHtml(exp.category || "Other") + '</span></td>' +
        '<td>' + escapeHtml(exp.description || "—") + '</td>' +
        '<td>' + escapeHtml(linkedShow) + '</td>' +
        '<td class="amt-neg">-' + fmtMoney(exp.amount) + '</td>' +
        '<td><button class="btn btn-ghost btn-small" data-del-exp="' + exp.id + '">Delete</button></td>';
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll("[data-del-exp]").forEach(function(btn){
      btn.addEventListener("click", function(){
        if(!confirm("Delete this expense?")) return;
        state.expenses = state.expenses.filter(function(e){ return e.id !== btn.dataset.delExp; });
        saveExpenses();
        renderExpenses();
        renderDashboard();
        toast("Expense deleted");
      });
    });
  }

  /* ---------------- Show pay calculations ---------------- */
  function getWorkerRate(){
    var rate = parseFloat(document.getElementById("show-worker-rate").value);
    return isNaN(rate) ? 0 : rate;
  }

  function getCommissionRate(){
    var rate = parseFloat(document.getElementById("pplus-rate").value);
    return isNaN(rate) ? 0 : rate;
  }

  function calculateShowPay(revenue, cost, duration, workerRate, commissionRate){
    var grossProfit = revenue - cost;
    var hoursWorked = (Number(duration) || 0) / 60;
    var hourlyPay = hoursWorked * (Number(workerRate) || 0);
    var rate = commissionRate === undefined || commissionRate === null ? state.commissionRate : Number(commissionRate);
    if(isNaN(rate)) rate = 0;
    var pplusCommission = grossProfit > 0 ? grossProfit * (rate / 100) : 0;
    var totalWorkerPay = hourlyPay + pplusCommission;
    var profit = grossProfit - totalWorkerPay;
    return {
      grossProfit: grossProfit,
      hoursWorked: hoursWorked,
      hourlyPay: hourlyPay,
      pplusCommission: pplusCommission,
      totalWorkerPay: totalWorkerPay,
      profit: profit,
      commissionRate: rate
    };
  }

  function showCostTotal(show){
    // Only COGS/show cost counts here. Employee pay is tracked separately
    // on the Employees tab and only affects profit when you manually add it
    // as an Expense.
    return Number(show.cost) || 0;
  }

  function isAutoShowExpense(e){
    return e && e.showId && (
      e.category === "Show Cost (Show)" ||
      e.category === "Worker Cost (Show)" ||
      e.category === "P+ Commission (Show)"
    );
  }

  function updateProfitPreview(){
    var revenue = parseFloat(document.getElementById("show-revenue").value) || 0;
    var cost = parseFloat(document.getElementById("show-cost").value) || 0;
    var duration = parseFloat(document.getElementById("show-duration").value) || 0;
    var workerRate = getWorkerRate();
    var commissionRate = getCommissionRate();
    var calc = calculateShowPay(revenue, cost, duration, workerRate, commissionRate);
    var el = document.getElementById("profit-preview-value");
    el.textContent = fmtMoney(calc.grossProfit);
    el.className = "pp-value " + (calc.grossProfit >= 0 ? "gain" : "loss");
    var workerEl = document.getElementById("worker-preview-value");
    if(workerEl){
      workerEl.textContent = fmtMoney(calc.totalWorkerPay) + " (" + fmtMoney(calc.hourlyPay) + " hourly + " + fmtMoney(calc.pplusCommission) + " commission)";
      workerEl.className = "pp-value";
    }
  }
  ["show-revenue","show-cost","show-duration","show-worker-rate","pplus-rate"].forEach(function(id){
    document.getElementById(id).addEventListener("input", function(){
      if(id === "show-worker-rate"){
        state.workerRate = getWorkerRate();
        saveWorkerRate();
      }
      if(id === "pplus-rate"){
        state.commissionRate = getCommissionRate();
        saveCommissionRate();
      }
      updateProfitPreview();
    });
  });

  /* ---------------- Add / Edit Show ---------------- */
  function clearShowForm(){
    ["show-title","show-revenue","show-items","show-viewers","show-duration","show-cost","show-employees","show-buyers","show-notes"].forEach(function(id){
      document.getElementById(id).value = "";
    });
    document.getElementById("show-type").value = "Show";
    document.getElementById("show-date").value = defaultDateForCurrentMonth();
    document.getElementById("show-worker-rate").value = state.workerRate ? state.workerRate.toFixed(2) : "";
    document.getElementById("pplus-rate").value = state.commissionRate === undefined ? "5" : state.commissionRate;
    editingShowId = null;
    document.getElementById("add-show-btn").textContent = "+ Log Deal";
    document.getElementById("cancel-edit-show-btn").style.display = "none";
    updateProfitPreview();
  }

  function populateShowFormForEdit(showId){
    var show = state.shows.find(function(s){ return s.id === showId; });
    if(!show){ toast("Could not find that deal"); return; }
    editingShowId = showId;
    document.getElementById("show-date").value = show.date || defaultDateForCurrentMonth();
    document.getElementById("show-type").value = show.type || "Show";
    document.getElementById("show-title").value = show.title || "";
    document.getElementById("show-revenue").value = show.revenue || "";
    document.getElementById("show-items").value = show.items || "";
    document.getElementById("show-viewers").value = show.viewers || "";
    document.getElementById("show-duration").value = show.duration || "";
    document.getElementById("show-cost").value = show.cost || "";
    document.getElementById("show-employees").value = (show.employees || []).join(", ");
    var rate = Number(show.workerRate);
    if(isNaN(rate)) rate = state.workerRate || 20;
    document.getElementById("show-worker-rate").value = rate ? rate.toFixed(2) : "";
    document.getElementById("pplus-rate").value = show.commissionRate === undefined ? (state.commissionRate === undefined ? 5 : state.commissionRate) : show.commissionRate;
    document.getElementById("show-buyers").value = show.buyers || "";
    document.getElementById("show-notes").value = show.notes || "";
    document.getElementById("add-show-btn").textContent = "Save Changes";
    document.getElementById("cancel-edit-show-btn").style.display = "inline-block";
    updateProfitPreview();
    document.getElementById("view-shows").scrollIntoView({behavior:"smooth", block:"start"});
    toast("Editing deal — save changes when done");
  }

  document.getElementById("cancel-edit-show-btn").addEventListener("click", function(){
    clearShowForm();
    toast("Edit canceled");
  });

  function parseEmployeeNames(value){
    return String(value || "").split(",").map(function(n){ return n.trim(); }).filter(Boolean).filter(function(n, i, arr){
      return arr.map(function(x){ return x.toLowerCase(); }).indexOf(n.toLowerCase()) === i;
    });
  }

  function addEmployeesFromNames(names){
    var changed = false;
    names.forEach(function(name){
      var exists = state.employees.some(function(e){ return e.name.toLowerCase() === name.toLowerCase(); });
      if(!exists){ state.employees.push({id: uid(), name: name}); changed = true; }
    });
    if(changed){ state.employees.sort(function(a,b){ return a.name.localeCompare(b.name); }); saveEmployees(); populateEmployeeDatalist(); }
  }

  document.getElementById("add-show-btn").addEventListener("click", function(){
    var date = document.getElementById("show-date").value || defaultDateForCurrentMonth();
    var dealType = document.getElementById("show-type").value || "Show";
    var defaultTitle = dealType === "Show" ? "Untitled Show" : dealType;
    var title = document.getElementById("show-title").value.trim() || defaultTitle;
    var revenue = parseFloat(document.getElementById("show-revenue").value) || 0;
    var items = parseInt(document.getElementById("show-items").value) || 0;
    var viewers = parseInt(document.getElementById("show-viewers").value) || 0;
    var duration = parseInt(document.getElementById("show-duration").value) || 0;
    var cost = parseFloat(document.getElementById("show-cost").value) || 0;
    var workerRate = getWorkerRate();
    var commissionRate = getCommissionRate();
    var employeeNames = parseEmployeeNames(document.getElementById("show-employees").value);
    addEmployeesFromNames(employeeNames);
    var buyers = parseInt(document.getElementById("show-buyers").value) || 0;
    var notes = document.getElementById("show-notes").value.trim();
    var calc = calculateShowPay(revenue, cost, duration, workerRate, commissionRate);

    var show = {
      id: editingShowId || uid(), date: date, type: dealType, title: title, revenue: revenue, items: items,
      viewers: viewers, duration: duration, cost: cost, workerRate: workerRate, commissionRate: commissionRate, employees: employeeNames,
      hourlyPay: calc.hourlyPay, pplusCommission: calc.pplusCommission,
      totalWorkerPay: calc.totalWorkerPay, grossProfit: calc.grossProfit,
      buyers: buyers, notes: notes, profit: calc.grossProfit
    };

    var wasEditing = !!editingShowId;
    if(wasEditing){
      state.shows = state.shows.map(function(s){ return s.id === editingShowId ? show : s; });
    } else {
      state.shows.push(show);
    }
    state.workerRate = workerRate;
    state.commissionRate = commissionRate;
    saveShows();
    saveWorkerRate();
    saveCommissionRate();

    var entryMonth = getMonthKey(date);
    ensureMonthExists(entryMonth);
    var switched = state.currentMonth !== "all" && state.currentMonth.indexOf("year:") !== 0 && state.currentMonth !== entryMonth;
    if(switched) state.currentMonth = entryMonth, saveCurrentMonth();

    clearShowForm();
    refreshAllViews();
    toast(wasEditing ? "Deal updated — gross profit " + fmtMoney(calc.grossProfit) : (switched ? "Deal added to " + fmtMonthLabel(entryMonth) + " — gross profit " + fmtMoney(calc.grossProfit) : "Deal logged — gross profit " + fmtMoney(calc.grossProfit)));
  });

  /* ---------------- Render Shows ---------------- */
  function renderShows(){
    var wrap = document.getElementById("shows-list");
    var list = state.shows.slice().sort(function(a,b){ return (b.date||"").localeCompare(a.date||""); });
    if(state.currentMonth !== "all") list = list.filter(function(s){ return inSelectedPeriod(s.date); });
    wrap.innerHTML = "";
    document.getElementById("shows-empty").style.display = list.length ? "none" : "block";
    document.getElementById("show-count").textContent = list.length + " deal" + (list.length===1?"":"s") + " logged";

    list.forEach(function(show){
      var cost = Number(show.cost) || 0;
      var workerRate = Number(show.workerRate);
      if(isNaN(workerRate)) workerRate = Number(show.hourlyRate) || 0;
      var commissionRate = show.commissionRate === undefined ? state.commissionRate : Number(show.commissionRate);
      if(isNaN(commissionRate)) commissionRate = 5;
      var calc = calculateShowPay(Number(show.revenue)||0, cost, Number(show.duration)||0, workerRate, commissionRate);
      if(show.hourlyPay !== undefined) calc.hourlyPay = Number(show.hourlyPay) || 0;
      else if(show.workerCost !== undefined && show.workerRate === undefined) calc.hourlyPay = Number(show.workerCost) || 0;
      if(show.pplusCommission !== undefined) calc.pplusCommission = Number(show.pplusCommission) || 0;
      calc.totalWorkerPay = calc.hourlyPay + calc.pplusCommission;
      var profit = calc.grossProfit;

      var card = document.createElement("div");
      card.className = "show-card";
      var dealType = show.type || "Show";
      card.innerHTML =
        '<div class="show-card-head">' +
          '<div><div class="show-title">' + escapeHtml(show.title) + '</div><div class="show-date"><span class="cat-tag">' + escapeHtml(dealType) + '</span> · ' + fmtDate(show.date) + '</div></div>' +
          '<div style="display:flex;gap:6px;flex-wrap:wrap;"><button class="btn btn-ghost btn-small" data-edit-show="' + show.id + '">Edit</button><button class="btn btn-ghost btn-small" data-del-show="' + show.id + '">Delete</button></div>' +
        '</div>' +
        '<div class="show-metrics">' +
          metric("Revenue", fmtMoney(show.revenue)) +
          metric("COGS", fmtMoney(cost)) +
          metric("Gross Profit", fmtMoney(calc.grossProfit)) +
          metric("Worker Rate", fmtMoney(workerRate) + "/hr") +
          metric("Hourly Pay", fmtMoney(calc.hourlyPay)) +
          metric("P+ Commission (" + calc.commissionRate + "%)", fmtMoney(calc.pplusCommission)) +
          metric("Total Worker Pay", fmtMoney(calc.totalWorkerPay)) +
          metric("Items Sold", show.items) +
          metric("Buyers", show.buyers) +
          metric("Peak Viewers", show.viewers) +
          metric("Duration", show.duration + " min") +
        '</div>' +
        '<div class="profit-strip ' + (profit >= 0 ? "gain" : "loss") + '"><span>Gross Profit</span><span>' + fmtMoney(profit) + '</span></div>' +
        (show.notes ? '<p style="margin:12px 0 0;font-size:12.5px;color:var(--muted);">' + escapeHtml(show.notes) + '</p>' : '');
      wrap.appendChild(card);
    });

    wrap.querySelectorAll("[data-edit-show]").forEach(function(btn){
      btn.addEventListener("click", function(){
        populateShowFormForEdit(btn.dataset.editShow);
      });
    });

    wrap.querySelectorAll("[data-del-show]").forEach(function(btn){
      btn.addEventListener("click", function(){
        if(!confirm("Delete this show?")) return;
        var id = btn.dataset.delShow;
        state.shows = state.shows.filter(function(s){ return s.id !== id; });
        state.expenses.forEach(function(e){ if(e.showId === id) e.showId = null; });
        saveShows(); saveExpenses();
        renderShows(); renderEmployees(); renderExpenses(); renderDashboard();
        toast("Show deleted");
      });
    });
  }

  function metric(label, value){
    return '<div><div class="metric-label">' + label + '</div><div class="metric-value">' + value + '</div></div>';
  }

  function escapeHtml(str){
    var div = document.createElement("div");
    div.textContent = str === undefined || str === null ? "" : String(str);
    return div.innerHTML;
  }

  /* ---------------- Employees ---------------- */
  function populateEmployeeDatalist(){
    var list = document.getElementById("employee-names-list");
    if(!list) return;
    list.innerHTML = "";
    state.employees.slice().sort(function(a,b){ return a.name.localeCompare(b.name); }).forEach(function(emp){
      var opt = document.createElement("option");
      opt.value = emp.name;
      list.appendChild(opt);
    });
  }

  function employeePayRows(){
    var shows = state.currentMonth === "all" ? state.shows : state.shows.filter(function(s){ return inSelectedPeriod(s.date); });
    var rows = [];
    shows.forEach(function(show){
      var names = (show.employees || []).filter(Boolean);
      if(!names.length) return;
      var cost = Number(show.cost) || 0;
      var workerRate = Number(show.workerRate);
      if(isNaN(workerRate)) workerRate = Number(show.hourlyRate) || 0;
      var commissionRate = show.commissionRate === undefined ? state.commissionRate : Number(show.commissionRate);
      if(isNaN(commissionRate)) commissionRate = 5;
      var calc = calculateShowPay(Number(show.revenue)||0, cost, Number(show.duration)||0, workerRate, commissionRate);
      if(show.hourlyPay !== undefined) calc.hourlyPay = Number(show.hourlyPay) || 0;
      else if(show.workerCost !== undefined && show.workerRate === undefined) calc.hourlyPay = Number(show.workerCost) || 0;
      if(show.pplusCommission !== undefined) calc.pplusCommission = Number(show.pplusCommission) || 0;
      var split = names.length;
      names.forEach(function(name){
        rows.push({
          date: show.date,
          employee: name,
          deal: show.title || "Untitled Deal",
          hourlyPay: calc.hourlyPay / split,
          commission: calc.pplusCommission / split,
          totalPay: (calc.hourlyPay + calc.pplusCommission) / split
        });
      });
    });
    var extraWork = state.currentMonth === "all" ? state.employeeWork : state.employeeWork.filter(function(w){ return inSelectedPeriod(w.date); });
    extraWork.forEach(function(w){
      rows.push({
        id: w.id,
        date: w.date,
        employee: w.employee,
        deal: w.workType + (w.notes ? " — " + w.notes : ""),
        hourlyPay: (Number(w.hours)||0) * (Number(w.rate)||0),
        commission: 0,
        totalPay: (Number(w.hours)||0) * (Number(w.rate)||0),
        source: "extra",
        hours: Number(w.hours)||0,
        rate: Number(w.rate)||0
      });
    });
    return rows;
  }

  function employeePayTotalForPeriod(){
    return employeePayRows().reduce(function(sum,r){ return sum + (Number(r.totalPay)||0); }, 0);
  }

  function renderEmployees(){
    populateEmployeeDatalist();
    var rows = employeePayRows();
    var summary = {};
    state.employees.forEach(function(emp){ summary[emp.name] = {name: emp.name, deals: 0, hourlyPay: 0, commission: 0, totalPay: 0}; });
    rows.forEach(function(r){
      if(!summary[r.employee]) summary[r.employee] = {name: r.employee, deals: 0, hourlyPay: 0, commission: 0, totalPay: 0};
      summary[r.employee].deals += 1;
      summary[r.employee].hourlyPay += r.hourlyPay;
      summary[r.employee].commission += r.commission;
      summary[r.employee].totalPay += r.totalPay;
    });
    var list = Object.keys(summary).map(function(k){ return summary[k]; }).sort(function(a,b){ return b.totalPay - a.totalPay || a.name.localeCompare(b.name); });
    var tbody = document.getElementById("employees-summary-tbody");
    var logBody = document.getElementById("employees-log-tbody");
    tbody.innerHTML = "";
    logBody.innerHTML = "";
    document.getElementById("employees-empty").style.display = list.length ? "none" : "block";
    document.getElementById("employees-log-empty").style.display = rows.length ? "none" : "block";
    document.getElementById("employee-count").textContent = list.length + " employee" + (list.length===1?"":"s");
    var totalPay = list.reduce(function(sum,e){ return sum + e.totalPay; }, 0);
    document.getElementById("employee-total-pay").textContent = fmtMoney(totalPay);

    list.forEach(function(emp){
      var tr = document.createElement("tr");
      tr.innerHTML =
        '<td>' + escapeHtml(emp.name) + '</td>' +
        '<td class="mono">' + emp.deals + '</td>' +
        '<td class="mono">' + fmtMoney(emp.hourlyPay) + '</td>' +
        '<td class="mono">' + fmtMoney(emp.commission) + '</td>' +
        '<td class="amt-pos">' + fmtMoney(emp.totalPay) + '</td>' +
        '<td><button class="btn btn-ghost btn-small" data-del-employee="' + escapeHtml(emp.name) + '">Remove</button></td>';
      tbody.appendChild(tr);
    });

    rows.sort(function(a,b){ return (b.date||"").localeCompare(a.date||""); }).forEach(function(r){
      var tr = document.createElement("tr");
      tr.innerHTML =
        '<td class="mono">' + fmtDate(r.date) + '</td>' +
        '<td>' + escapeHtml(r.employee) + '</td>' +
        '<td>' + escapeHtml(r.deal) + '</td>' +
        '<td class="mono">' + fmtMoney(r.hourlyPay) + '</td>' +
        '<td class="mono">' + fmtMoney(r.commission) + '</td>' +
        '<td class="amt-pos">' + fmtMoney(r.totalPay) + '</td>' +
        '<td>' + (r.source === "extra" ? '<button class="btn btn-ghost btn-small" data-del-extra-work="' + r.id + '">Delete</button>' : '') + '</td>';
      logBody.appendChild(tr);
    });

    logBody.querySelectorAll("[data-del-extra-work]").forEach(function(btn){
      btn.addEventListener("click", function(){
        if(!confirm("Delete this extra work entry?")) return;
        state.employeeWork = state.employeeWork.filter(function(w){ return w.id !== btn.dataset.delExtraWork; });
        saveEmployeeWork();
        renderEmployees();
        renderExpenses();
        renderDashboard();
        toast("Extra work deleted");
      });
    });

    tbody.querySelectorAll("[data-del-employee]").forEach(function(btn){
      btn.addEventListener("click", function(){
        var name = btn.dataset.delEmployee;
        if(!confirm("Remove " + name + " from employees list? Their old show pay logs stay if their name is still on past deals.")) return;
        state.employees = state.employees.filter(function(e){ return e.name !== name; });
        saveEmployees();
        renderEmployees();
        renderExpenses();
        renderDashboard();
        toast("Employee removed");
      });
    });
  }

  document.getElementById("add-employee-btn").addEventListener("click", function(){
    var input = document.getElementById("employee-name-input");
    var names = parseEmployeeNames(input.value);
    if(!names.length){ toast("Enter an employee name"); return; }
    addEmployeesFromNames(names);
    input.value = "";
    renderEmployees();
    renderExpenses();
    renderDashboard();
    toast("Employee added");
  });

  document.getElementById("refresh-employees-btn").addEventListener("click", function(){
    renderEmployees();
    renderExpenses();
    renderDashboard();
    toast("Employee pay refreshed");
  });

  document.getElementById("add-extra-work-btn").addEventListener("click", function(){
    var date = document.getElementById("extra-work-date").value || defaultDateForCurrentMonth();
    var name = document.getElementById("extra-employee-name").value.trim();
    var workType = document.getElementById("extra-work-type").value || "Other Work";
    var hours = parseFloat(document.getElementById("extra-work-hours").value);
    var rate = parseFloat(document.getElementById("extra-work-rate").value);
    var notes = document.getElementById("extra-work-notes").value.trim();
    if(!name){ toast("Enter employee name"); return; }
    if(isNaN(hours) || hours <= 0){ toast("Enter valid hours"); return; }
    if(isNaN(rate) || rate < 0){ toast("Enter valid rate"); return; }
    addEmployeesFromNames([name]);
    state.employeeWork.push({ id: uid(), date: date, employee: name, workType: workType, hours: hours, rate: rate, notes: notes });
    saveEmployeeWork();
    document.getElementById("extra-work-date").value = defaultDateForCurrentMonth();
    document.getElementById("extra-employee-name").value = "";
    document.getElementById("extra-work-hours").value = "";
    document.getElementById("extra-work-notes").value = "";
    renderEmployees();
    renderExpenses();
    renderDashboard();
    toast("Extra work pay added");
  });

  /* ---------------- Add Inventory (reference only — never touches Dashboard totals) ---------------- */
  document.getElementById("add-inventory-btn").addEventListener("click", function(){
    var date = document.getElementById("inv-date").value || defaultDateForCurrentMonth();
    var item = document.getElementById("inv-item").value.trim();
    var qty = parseInt(document.getElementById("inv-qty").value) || 0;
