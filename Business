  /* ---------------- Dashboard ---------------- */
  function renderDashboard(){
    var shows = state.currentMonth === "all" ? state.shows : state.shows.filter(function(s){ return inSelectedPeriod(s.date); });
    var expenses = state.currentMonth === "all" ? state.expenses : state.expenses.filter(function(e){ return inSelectedPeriod(e.date); });

    var manualExpenses = expenses.filter(function(e){ return !isAutoShowExpense(e); });
    var totalRevenue = shows.reduce(function(sum,s){ return sum + (Number(s.revenue)||0); }, 0);
    var totalShowCosts = shows.reduce(function(sum,s){ return sum + showCostTotal(s); }, 0);
    var totalManualExpenses = manualExpenses.reduce(function(sum,e){ return sum + (Number(e.amount)||0); }, 0);
    var totalEmployeePay = employeePayTotalForPeriod();
    var totalExpenses = totalManualExpenses + totalShowCosts + totalEmployeePay;
    var net = totalRevenue - totalExpenses;

    document.getElementById("stat-revenue").textContent = fmtMoney(totalRevenue);
    document.getElementById("stat-expenses").textContent = fmtMoney(totalExpenses);
    var netEl = document.getElementById("stat-net");
    netEl.textContent = fmtMoney(net);
    netEl.className = "stat-value mono " + (net >= 0 ? "gain" : "loss");
    document.getElementById("stat-shows").textContent = shows.length;

    document.getElementById("rc-revenue").textContent = fmtMoney(totalRevenue);
    document.getElementById("rc-expenses").textContent = fmtMoney(totalExpenses);
    document.getElementById("rc-avg-rev").textContent = fmtMoney(shows.length ? totalRevenue/shows.length : 0);
    var totalItems = shows.reduce(function(sum,s){ return sum + (Number(s.items)||0); }, 0);
    document.getElementById("rc-avg-items").textContent = shows.length ? Math.round(totalItems/shows.length) : 0;
    var netRow = document.getElementById("rc-net");
    netRow.textContent = fmtMoney(net);
    netRow.style.color = net >= 0 ? "var(--gain)" : "var(--hype)";
    document.getElementById("receipt-date").textContent = fmtMonthLabel(state.currentMonth) + " · as of " + fmtDate(localDateStr());

    var byCategory = {};
    manualExpenses.forEach(function(e){
      var cat = e.category || "Other";
      byCategory[cat] = (byCategory[cat] || 0) + (Number(e.amount)||0);
    });
    shows.forEach(function(s){
      var cost = Number(s.cost) || 0;
      var workerRate = Number(s.workerRate);
      if(isNaN(workerRate)) workerRate = Number(s.hourlyRate) || 0;
      var commissionRate = s.commissionRate === undefined ? state.commissionRate : Number(s.commissionRate);
      if(isNaN(commissionRate)) commissionRate = 5;
      var calc = calculateShowPay(Number(s.revenue)||0, cost, Number(s.duration)||0, workerRate, commissionRate);
      if(s.hourlyPay !== undefined) calc.hourlyPay = Number(s.hourlyPay) || 0;
      else if(s.workerCost !== undefined && s.workerRate === undefined) calc.hourlyPay = Number(s.workerCost) || 0;
      if(s.pplusCommission !== undefined) calc.pplusCommission = Number(s.pplusCommission) || 0;
      if(cost > 0) byCategory["COGS Sold"] = (byCategory["COGS Sold"] || 0) + cost;
    });
    if(totalEmployeePay > 0) byCategory["Employee Pay"] = totalEmployeePay;
    var catList = Object.keys(byCategory).map(function(k){ return {cat:k, amt:byCategory[k]}; });
    catList.sort(function(a,b){ return b.amt - a.amt; });
    var maxAmt = catList.length ? catList[0].amt : 0;

    var barsWrap = document.getElementById("category-bars");
    barsWrap.innerHTML = "";
    if(!catList.length){
      barsWrap.innerHTML = '<div class="empty-state">No expenses logged yet</div>';
    } else {
      catList.forEach(function(item){
        var pct = maxAmt ? Math.max(4, (item.amt/maxAmt)*100) : 0;
        var row = document.createElement("div");
        row.className = "bar-row";
        row.innerHTML =
          '<div class="bar-label"><span>' + escapeHtml(item.cat) + '</span><span class="amt">' + fmtMoney(item.amt) + '</span></div>' +
          '<div class="bar-track"><div class="bar-fill" style="width:' + pct + '%"></div></div>';
        barsWrap.appendChild(row);
      });
    }
